# Copy to .env on the server (cp .env.example .env) and fill in. Never commit .env.
# Passwords: at least 8 characters with upper case, lower case and digits; do not use ' ; " $ or spaces.

# Your domain, already pointing (DNS A record) at the server's IP. No https://, no trailing slash.
DOMAIN=safelearnkids.example.com

# SQL Server administrator (used only to create the database) and the app's own SQL login.
MSSQL_SA_PASSWORD=ChangeMe-Sa-2026x
APP_DB_PASSWORD=ChangeMe-App-2026x
# SQL Server memory cap in MB (server with 4 GB RAM: 1536; 8 GB: 4096).
MSSQL_MEMORY_LIMIT_MB=1536

# Mail for account confirmation and password reset (Brevo, Zoho, Gmail app password, Mailgun, ...).
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@safelearnkids.example.com

# First administrator, created at start-up only while no admin can sign in. Remove both lines after the first sign-in.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional: YouTube Data API key (sync sources) and Anthropic key (AI question suggestions).
YOUTUBE_API_KEY=
AI_API_KEY=
