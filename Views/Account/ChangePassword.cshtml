@model ChangePasswordViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Đổi mật khẩu";
    ViewData["Page"] = "change-password";
}
<main id="main" class="auth-shell auth-shell-centered" tabindex="-1">
    <section class="auth-card sl-card" aria-labelledby="change-title">
        <partial name="_AuthBrand" />
        <header class="auth-heading">
            <h1 id="change-title" class="sl-h1">Đổi mật khẩu</h1>
            <p class="sub">Chọn mật khẩu riêng để bảo vệ tài khoản của bạn.</p>
        </header>
        <form asp-action="ChangePassword" method="post" class="auth-form d-grid gap-3" data-auth-form data-submit-label="Đang đổi mật khẩu…">
            <div asp-validation-summary="ModelOnly" class="banner t-r auth-alert" role="alert" tabindex="-1" data-auth-feedback></div>
            <div class="field">
                <label asp-for="CurrentPassword" class="lab form-label"></label>
                <div class="auth-password">
                    <input asp-for="CurrentPassword" class="form-control inp" autocomplete="current-password" maxlength="100" required aria-describedby="CurrentPassword-validation" />
                    <button type="button" class="auth-toggle" data-password-toggle="CurrentPassword" aria-controls="CurrentPassword" aria-label="Hiện mật khẩu hiện tại" aria-pressed="false" hidden>Hiện</button>
                </div>
                <span asp-validation-for="CurrentPassword" id="CurrentPassword-validation" class="err" aria-live="polite"></span>
            </div>
            <div class="field">
                <label asp-for="Password" class="lab form-label"></label>
                <div class="auth-password">
                    <input asp-for="Password" class="form-control inp" autocomplete="new-password" minlength="8" maxlength="100" required aria-describedby="change-policy Password-validation" />
                    <button type="button" class="auth-toggle" data-password-toggle="Password" aria-controls="Password" aria-label="Hiện mật khẩu mới" aria-pressed="false" hidden>Hiện</button>
                </div>
                <span asp-validation-for="Password" id="Password-validation" class="err" aria-live="polite"></span>
                <p id="change-policy" class="hint">Ít nhất 8 ký tự, có chữ thường và chữ số.</p>
            </div>
            <div class="field">
                <label asp-for="ConfirmPassword" class="lab form-label"></label>
                <div class="auth-password">
                    <input asp-for="ConfirmPassword" class="form-control inp" autocomplete="new-password" maxlength="100" required aria-describedby="ConfirmPassword-validation" />
                    <button type="button" class="auth-toggle" data-password-toggle="ConfirmPassword" aria-controls="ConfirmPassword" aria-label="Hiện mật khẩu mới nhập lại" aria-pressed="false" hidden>Hiện</button>
                </div>
                <span asp-validation-for="ConfirmPassword" id="ConfirmPassword-validation" class="err" aria-live="polite"></span>
            </div>
            <button type="submit" class="sl-btn sl-btn-p sl-btn-lg sl-btn-block">Đổi mật khẩu</button>
            <p class="auth-submit-status hint" role="status" aria-live="polite" data-submit-status></p>
        </form>
        <a href="~/recover" class="sl-btn sl-btn-s sl-btn-block">Yêu cầu liên kết khôi phục</a>
        <a href="~/settings" class="auth-link auth-footer">Quay lại tài khoản</a>
    </section>
</main>
