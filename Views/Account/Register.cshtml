@model RegisterViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Đăng ký tài khoản phụ huynh";
    ViewData["Page"] = "register";
}
<main id="main" class="auth-shell auth-shell-split" tabindex="-1">
    <section class="auth-main" aria-labelledby="register-title">
        <div class="auth-content">
            <partial name="_AuthBrand" />
            <header class="auth-heading">
                <h1 id="register-title" class="sl-h1">Tạo tài khoản phụ huynh</h1>
                <p class="sub">Bắt đầu hành trình học an toàn cùng con.</p>
            </header>
            <form asp-action="Register" method="post" class="auth-form d-grid gap-3" data-auth-form data-submit-label="Đang tạo tài khoản…">
                <div asp-validation-summary="ModelOnly" class="banner t-r auth-alert" role="alert" tabindex="-1" data-auth-feedback></div>
                <div class="field">
                    <label asp-for="FullName" class="lab form-label"></label>
                    <input asp-for="FullName" class="form-control inp" autocomplete="name" placeholder="Họ và tên của bạn" minlength="2" maxlength="100" data-msg-minlength="Họ và tên cần từ 2 đến 100 ký tự." required aria-describedby="FullName-validation" />
                    <span asp-validation-for="FullName" id="FullName-validation" class="err" aria-live="polite"></span>
                </div>
                <div class="field">
                    <label asp-for="Email" class="lab form-label"></label>
                    <input asp-for="Email" type="email" class="form-control inp" autocomplete="email" inputmode="email" autocapitalize="none" spellcheck="false" placeholder="ban@example.com" required aria-describedby="Email-validation" />
                    <span asp-validation-for="Email" id="Email-validation" class="err" aria-live="polite"></span>
                </div>
                <div class="field">
                    <label asp-for="Password" class="lab form-label"></label>
                    <div class="auth-password">
                        <input asp-for="Password" class="form-control inp" autocomplete="new-password" minlength="8" maxlength="100" data-msg-minlength="Mật khẩu tối thiểu 8 ký tự." required aria-describedby="password-policy Password-validation password-strength" />
                        <button type="button" class="auth-toggle" data-password-toggle="Password" aria-controls="Password" aria-label="Hiện mật khẩu" aria-pressed="false" hidden>Hiện</button>
                    </div>
                    <span asp-validation-for="Password" id="Password-validation" class="err" aria-live="polite"></span>
                    <p id="password-policy" class="hint">Ít nhất 8 ký tự, có chữ thường và chữ số. Có thể thêm chữ hoa, ký hiệu để mạnh hơn.</p>
                    <div id="r-meter" class="auth-meter" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
                    <p id="password-strength" class="hint" aria-live="polite">Độ mạnh tham khảo; mật khẩu sẽ được kiểm tra khi đăng ký.</p>
                </div>
                <div class="field">
                    <label asp-for="ConfirmPassword" class="lab form-label"></label>
                    <div class="auth-password">
                        <input asp-for="ConfirmPassword" class="form-control inp" autocomplete="new-password" maxlength="100" required aria-describedby="ConfirmPassword-validation" />
                        <button type="button" class="auth-toggle" data-password-toggle="ConfirmPassword" aria-controls="ConfirmPassword" aria-label="Hiện mật khẩu nhập lại" aria-pressed="false" hidden>Hiện</button>
                    </div>
                    <span asp-validation-for="ConfirmPassword" id="ConfirmPassword-validation" class="err" aria-live="polite"></span>
                </div>
                <div class="field">
                    <div class="form-check auth-check auth-consent">
                        <input asp-for="Agree" class="form-check-input chk" required data-auth-agree data-msg-required="Hãy xác nhận bạn là phụ huynh và đồng ý điều khoản." aria-describedby="Agree-validation" />
                        <label asp-for="Agree" class="form-check-label">Tôi là phụ huynh hoặc người giám hộ, đồng ý với điều khoản và chính sách dữ liệu của trẻ em.</label>
                    </div>
                    <span asp-validation-for="Agree" id="Agree-validation" class="err" aria-live="polite"></span>
                </div>
                <button type="submit" class="sl-btn sl-btn-p sl-btn-lg sl-btn-block">Tạo tài khoản</button>
                <p class="auth-submit-status hint" role="status" aria-live="polite" data-submit-status></p>
            </form>
            <p class="auth-footer">Đã có tài khoản? <a href="~/login" class="auth-link">Đăng nhập</a></p>
        </div>
    </section>
    <aside class="auth-story" aria-labelledby="register-story-title">
        <span class="chip auth-story-chip">Cùng con học an toàn</span>
        <div>
            <h2 id="register-story-title">Khởi đầu nhỏ.<br />Thói quen tốt mỗi ngày.</h2>
            <p>Ba mẹ đồng hành cùng con từ những bài học đầu tiên.</p>
            <ol class="auth-steps">
                <li><span>1</span><div><strong>Tài khoản của ba mẹ</strong><p>Quản lý việc học trong không gian riêng.</p></div></li>
                <li><span>2</span><div><strong>Hành trình của con</strong><p>Cùng con chọn nội dung phù hợp.</p></div></li>
                <li><span>3</span><div><strong>Từng bước tiến bộ</strong><p>Dành thời gian cho việc học mỗi ngày.</p></div></li>
            </ol>
        </div>
        <div class="auth-story-foot">SafeLearn Kids · Cùng con lớn lên</div>
    </aside>
</main>
