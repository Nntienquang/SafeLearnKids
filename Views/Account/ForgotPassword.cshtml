@model ForgotPasswordViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Quên mật khẩu";
    ViewData["Page"] = "recover";
    var sent = ViewData["Sent"] is true;
}
<main id="main" class="auth-shell auth-shell-centered" tabindex="-1">
    <section class="auth-card sl-card" aria-labelledby="recover-title">
        <partial name="_AuthBrand" />
        <div class="ib ib-l t-p"><i class="ic ic-key ic-lg" aria-hidden="true"></i></div>
        <header class="auth-heading">
            <h1 id="recover-title" class="sl-h1">Quên mật khẩu?</h1>
            <p class="sub">Nhập email bạn dùng để đăng ký. Chúng tôi sẽ tiếp nhận yêu cầu khôi phục tài khoản.</p>
        </header>
        @if (sent)
        {
            <div class="banner t-g auth-alert" role="status" tabindex="-1" data-auth-feedback>Đã tiếp nhận yêu cầu. Nếu email đủ điều kiện, bạn sẽ nhận được hướng dẫn khôi phục. Hãy kiểm tra cả thư rác.</div>
        }
        <form asp-action="ForgotPassword" method="post" class="auth-form" data-auth-form data-submit-label="Đang gửi yêu cầu…">
            <div asp-validation-summary="ModelOnly" class="banner t-r auth-alert" role="alert" tabindex="-1" data-auth-feedback></div>
            <div class="field">
                <label asp-for="Email" class="lab"></label>
                <input asp-for="Email" type="email" class="inp" placeholder="ban@example.com" autocomplete="email" inputmode="email" autocapitalize="none" spellcheck="false" required aria-describedby="Email-validation" />
                <span asp-validation-for="Email" id="Email-validation" class="err" aria-live="polite"></span>
            </div>
            <button type="submit" class="sl-btn sl-btn-p sl-btn-lg sl-btn-block">@(sent ? "Gửi lại yêu cầu" : "Gửi yêu cầu khôi phục")</button>
            <p class="auth-submit-status hint" role="status" aria-live="polite" data-submit-status></p>
        </form>
        <a class="sl-btn sl-btn-g sl-btn-block" href="~/login"><i class="ic ic-arrowl" aria-hidden="true"></i>Quay lại đăng nhập</a>
        <p class="hint">Nếu liên kết cũ không mở được, hãy yêu cầu liên kết mới.</p>
    </section>
</main>