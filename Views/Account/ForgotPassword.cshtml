@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Quên mật khẩu";
    ViewData["Page"] = "recover";
    ViewData["Area"] = "public";
    var sent = ViewData["Sent"] is true;
    var demoLink = ViewData["DemoResetLink"] as string;
}
<main id="main" style="flex:1;min-width:0;padding:40px;display:flex;align-items:center;justify-content:center;background:var(--bg)">
    <div class="sl-card" style="flex:1 1 420px;max-width:460px;padding:34px;display:flex;flex-direction:column;gap:18px">
        <div class="ib t-p" style="width:56px;height:56px;border-radius:18px"><i class="ic ic-key ic-lg"></i></div>
        <div><h1 class="sl-h1" style="font-size:28px">Quên mật khẩu?</h1><p class="sub">Nhập email đã đăng ký, SafeLearn Kids gửi liên kết đặt lại mật khẩu có hiệu lực 30 phút.</p></div>
        <form asp-action="ForgotPassword" method="post" style="display:flex;flex-direction:column;gap:18px">
            <div class="field"><label asp-for="Email" class="lab"></label><input asp-for="Email" class="inp" placeholder="ban@example.com" /><span asp-validation-for="Email" class="err"></span></div>
            <button type="submit" class="sl-btn sl-btn-p sl-btn-lg sl-btn-block">Gửi liên kết đặt lại</button>
        </form>
        <a class="sl-btn sl-btn-g sl-btn-block" href="~/login"><i class="ic ic-arrowl"></i>Quay lại đăng nhập</a>
        @if (sent)
        {
            <div class="banner t-g" role="status" style="font-size:13.5px;font-weight:600"><i class="ic ic-checkc"></i>Nếu email tồn tại, liên kết đã được gửi. Kiểm tra hộp thư (kể cả thư rác).</div>
            @if (!string.IsNullOrEmpty(demoLink))
            {
                <div class="banner t-a" style="font-size:12.5px;font-weight:600;word-break:break-all"><i class="ic ic-info"></i><span>Demo (Development): <a href="@demoLink" style="text-decoration:underline">mở liên kết đặt lại</a></span></div>
            }
        }
    </div>
</main>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
