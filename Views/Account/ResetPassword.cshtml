@model ResetPasswordViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Đặt mật khẩu mới";
    ViewData["Page"] = "reset-password";
    var invalidLink = (ViewData.ModelState.TryGetValue(nameof(Model.Email), out var emailState) && emailState.Errors.Count > 0)
        || (ViewData.ModelState.TryGetValue(nameof(Model.Token), out var tokenState) && tokenState.Errors.Count > 0);
}
<main id="main" class="auth-shell auth-shell-centered" tabindex="-1">
    <section class="auth-card sl-card" aria-labelledby="reset-title">
        <partial name="_AuthBrand" />
        <div class="ib ib-l t-p"><i class="ic ic-lock ic-lg" aria-hidden="true"></i></div>
        <header class="auth-heading">
            <h1 id="reset-title" class="sl-h1">Đặt mật khẩu mới</h1>
            <p id="password-policy" class="sub">Ít nhất 8 ký tự, có chữ thường và chữ số. Chọn mật khẩu riêng cho tài khoản này.</p>
        </header>
        <form asp-action="ResetPassword" method="post" class="auth-form" data-auth-form data-submit-label="Đang lưu mật khẩu…">
            <input type="hidden" asp-for="Email" />
            <input type="hidden" asp-for="Token" />
            @if (invalidLink)
            {
                <div class="banner t-r auth-alert" role="alert" tabindex="-1" data-auth-feedback>Liên kết không hợp lệ. Hãy yêu cầu liên kết mới.</div>
            }
            <div asp-validation-summary="ModelOnly" class="banner t-r auth-alert" role="alert" tabindex="-1" data-auth-feedback></div>
            <div class="field">
                <label asp-for="Password" class="lab"></label>
                <div class="auth-password">
                    <input asp-for="Password" class="inp" autocomplete="new-password" minlength="8" maxlength="100" data-msg-minlength="Mật khẩu mới tối thiểu 8 ký tự." required aria-describedby="password-policy Password-validation" />
                    <button type="button" class="auth-toggle" data-password-toggle="Password" aria-controls="Password" aria-label="Hiện mật khẩu mới" aria-pressed="false" hidden>Hiện</button>
                </div>
                <span asp-validation-for="Password" id="Password-validation" class="err" aria-live="polite"></span>
            </div>
            <div class="field">
                <label asp-for="ConfirmPassword" class="lab"></label>
                <div class="auth-password">
                    <input asp-for="ConfirmPassword" class="inp" autocomplete="new-password" maxlength="100" required aria-describedby="ConfirmPassword-validation" />
                    <button type="button" class="auth-toggle" data-password-toggle="ConfirmPassword" aria-controls="ConfirmPassword" aria-label="Hiện mật khẩu mới nhập lại" aria-pressed="false" hidden>Hiện</button>
                </div>
                <span asp-validation-for="ConfirmPassword" id="ConfirmPassword-validation" class="err" aria-live="polite"></span>
            </div>
            <button type="submit" class="sl-btn sl-btn-p sl-btn-lg sl-btn-block">Lưu mật khẩu mới</button>
            <p class="auth-submit-status hint" role="status" aria-live="polite" data-submit-status></p>
        </form>
        <p class="auth-footer">Liên kết không dùng được? <a href="~/recover" class="auth-link">Yêu cầu liên kết mới</a></p>
        <a class="sl-btn sl-btn-g sl-btn-block" href="~/login"><i class="ic ic-arrowl" aria-hidden="true"></i>Quay lại đăng nhập</a>
    </section>
</main>
