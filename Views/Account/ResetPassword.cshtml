@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Đặt mật khẩu mới";
    ViewData["Page"] = "recover";
    ViewData["Area"] = "public";
}
<main id="main" style="flex:1;min-width:0;padding:40px;display:flex;align-items:center;justify-content:center;background:var(--bg)">
    <form asp-action="ResetPassword" method="post" class="sl-card" style="flex:1 1 420px;max-width:460px;padding:34px;display:flex;flex-direction:column;gap:18px">
        <input type="hidden" asp-for="Email" />
        <input type="hidden" asp-for="Token" />
        <div><h1 class="sl-h1" style="font-size:26px">Đặt mật khẩu mới</h1><p class="sub">Mật khẩu mới tối thiểu 8 ký tự.</p></div>
        <div asp-validation-summary="ModelOnly" class="banner t-r" role="alert" style="font-size:13.5px;font-weight:600"></div>
        <div class="field"><label asp-for="Password" class="lab"></label><input asp-for="Password" class="inp" autocomplete="new-password" /><span asp-validation-for="Password" class="err"></span></div>
        <div class="field"><label asp-for="ConfirmPassword" class="lab"></label><input asp-for="ConfirmPassword" class="inp" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword" class="err"></span></div>
        <button type="submit" class="sl-btn sl-btn-p sl-btn-lg sl-btn-block">Lưu mật khẩu mới</button>
    </form>
</main>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
