@model LoginViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Đăng nhập";
    ViewData["Page"] = "login";
    var signInFailed = ViewData.ModelState.TryGetValue(string.Empty, out var state) && state.Errors.Count > 0;
}
<main id="main" class="auth-shell auth-shell-split" tabindex="-1">
    <section class="auth-main" aria-labelledby="login-title">
        <div class="auth-content">
            <partial name="_AuthBrand" />
            <header class="auth-heading">
                <h1 id="login-title" class="sl-h1">Chào mừng quay lại</h1>
                <p class="sub">Đăng nhập để đồng hành cùng con mỗi ngày.</p>
            </header>
            @if (TempData["Info"] is string info)
            {
                <div class="banner t-g auth-alert" role="status" tabindex="-1" data-auth-feedback>@info</div>
            }
            @if (signInFailed)
            {
                <div class="banner t-r auth-alert" role="alert" tabindex="-1" data-auth-feedback>Không thể đăng nhập. Hãy kiểm tra email, mật khẩu hoặc thử lại sau.</div>
            }
            <form asp-action="Login" method="post" class="auth-form d-grid gap-3" data-auth-form data-submit-label="Đang đăng nhập…">
                <input type="hidden" asp-for="ReturnUrl" />
                <div class="field">
                    <label asp-for="Email" class="lab form-label"></label>
                    <input asp-for="Email" type="email" class="form-control inp" autocomplete="username" inputmode="email" autocapitalize="none" spellcheck="false" placeholder="ban@example.com" required aria-describedby="Email-validation" />
                    <span asp-validation-for="Email" id="Email-validation" class="err" aria-live="polite"></span>
                </div>
                <div class="field">
                    <label asp-for="Password" class="lab form-label"></label>
                    <div class="auth-password">
                        <input asp-for="Password" class="form-control inp" autocomplete="current-password" required aria-describedby="Password-validation" />
                        <button type="button" class="auth-toggle" data-password-toggle="Password" aria-controls="Password" aria-label="Hiện mật khẩu" aria-pressed="false" hidden>Hiện</button>
                    </div>
                    <span asp-validation-for="Password" id="Password-validation" class="err" aria-live="polite"></span>
                </div>
                <div class="auth-options d-flex flex-wrap align-items-center justify-content-between gap-2">
                    <div class="form-check auth-check">
                        <input asp-for="RememberMe" class="form-check-input chk" />
                        <label asp-for="RememberMe" class="form-check-label"></label>
                    </div>
                    <a href="~/recover" class="auth-link">Quên mật khẩu?</a>
                </div>
                <button type="submit" class="sl-btn sl-btn-p sl-btn-lg sl-btn-block">Đăng nhập</button>
                <p class="auth-submit-status hint" role="status" aria-live="polite" data-submit-status></p>
            </form>
            <p class="auth-note"><i class="ic ic-shield" aria-hidden="true"></i>Chỉ ghi nhớ đăng nhập trên thiết bị riêng của bạn.</p>
            <p class="auth-footer">Chưa có tài khoản? <a href="~/register" class="auth-link">Đăng ký</a></p>
            <p class="auth-footer"><a href="~/check-email" class="auth-link">Gửi lại email xác minh</a></p>
        </div>
    </section>
    <aside class="auth-story" aria-labelledby="login-story-title">
        <span class="chip auth-story-chip">Dành cho phụ huynh</span>
        <div>
            <h2 id="login-story-title">Mỗi bước học của con,<br />đều có ba mẹ bên cạnh.</h2>
            <p>Một nơi để ba mẹ chọn nội dung, sắp xếp giờ học và cùng con xây dựng thói quen tốt.</p>
        </div>
        <div class="auth-story-foot"><i class="ic ic-grad" aria-hidden="true"></i>SafeLearn Kids · Cùng con lớn lên</div>
    </aside>
</main>
