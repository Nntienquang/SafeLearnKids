@{
    ViewData["Title"] = """Hệ thống thiết kế""";
    ViewData["Page"] = "design-system";
    ViewData["Area"] = "public";
}
<main style="flex:1;min-width:0;padding:40px 48px;display:flex;flex-direction:column;gap:26px">
<div><h1 class="sl-h1" style="font-size:34px">Hệ thống thiết kế SafeLearn Kids</h1><p class="sub">Một bộ token dùng chung cho sáng, tối, giao diện bé và quản trị.</p></div>
<section class="sl-card"><div class="card-t" style="margin-bottom:14px">Màu sắc</div><div class="wrap" style="gap:14px"><div class="sl-col" style="gap:6px;flex:1 1 120px"><div style="height:64px;border-radius:16px;background:var(--bg);border:1px solid var(--line)"></div><div class="b" style="font-size:12.5px">Nền</div><div class="muted" style="font-size:11.5px">--bg</div></div><div class="sl-col" style="gap:6px;flex:1 1 120px"><div style="height:64px;border-radius:16px;background:var(--surface);border:1px solid var(--line)"></div><div class="b" style="font-size:12.5px">Bề mặt</div><div class="muted" style="font-size:11.5px">--surface</div></div><div class="sl-col" style="gap:6px;flex:1 1 120px"><div style="height:64px;border-radius:16px;background:var(--surface-2);border:1px solid var(--line)"></div><div class="b" style="font-size:12.5px">Bề mặt 2</div><div class="muted" style="font-size:11.5px">--surface-2</div></div><div class="sl-col" style="gap:6px;flex:1 1 120px"><div style="height:64px;border-radius:16px;background:var(--line);border:1px solid var(--line)"></div><div class="b" style="font-size:12.5px">Đường kẻ</div><div class="muted" style="font-size:11.5px">--line</div></div><div class="sl-col" style="gap:6px;flex:1 1 120px"><div style="height:64px;border-radius:16px;background:var(--primary);border:1px solid var(--line)"></div><div class="b" style="font-size:12.5px">Chính</div><div class="muted" style="font-size:11.5px">--primary</div></div><div class="sl-col" style="gap:6px;flex:1 1 120px"><div style="height:64px;border-radius:16px;background:var(--primary-2);border:1px solid var(--line)"></div><div class="b" style="font-size:12.5px">Chính 2</div><div class="muted" style="font-size:11.5px">--primary-2</div></div><div class="sl-col" style="gap:6px;flex:1 1 120px"><div style="height:64px;border-radius:16px;background:var(--teal);border:1px solid var(--line)"></div><div class="b" style="font-size:12.5px">Xanh ngọc</div><div class="muted" style="font-size:11.5px">--teal</div></div><div class="sl-col" style="gap:6px;flex:1 1 120px"><div style="height:64px;border-radius:16px;background:var(--sun);border:1px solid var(--line)"></div><div class="b" style="font-size:12.5px">Vàng</div><div class="muted" style="font-size:11.5px">--sun</div></div><div class="sl-col" style="gap:6px;flex:1 1 120px"><div style="height:64px;border-radius:16px;background:var(--rose);border:1px solid var(--line)"></div><div class="b" style="font-size:12.5px">Hồng</div><div class="muted" style="font-size:11.5px">--rose</div></div><div class="sl-col" style="gap:6px;flex:1 1 120px"><div style="height:64px;border-radius:16px;background:var(--green);border:1px solid var(--line)"></div><div class="b" style="font-size:12.5px">Xanh lá</div><div class="muted" style="font-size:11.5px">--green</div></div><div class="sl-col" style="gap:6px;flex:1 1 120px"><div style="height:64px;border-radius:16px;background:var(--blue);border:1px solid var(--line)"></div><div class="b" style="font-size:12.5px">Xanh dương</div><div class="muted" style="font-size:11.5px">--blue</div></div><div class="sl-col" style="gap:6px;flex:1 1 120px"><div style="height:64px;border-radius:16px;background:var(--violet);border:1px solid var(--line)"></div><div class="b" style="font-size:12.5px">Tím</div><div class="muted" style="font-size:11.5px">--violet</div></div></div></section>
<div style="display:flex;flex-wrap:wrap;gap:16px">
<section class="sl-card" style="flex:1 1 380px"><div class="card-t" style="margin-bottom:14px">Chữ</div><div class="sl-col" style="gap:10px"><div style="font-size:34px;font-weight:800;letter-spacing:-.03em">Tiêu đề lớn 34/800</div><div style="font-size:22px;font-weight:800">Tiêu đề mục 22/800</div><div style="font-size:15px;font-weight:600">Nội dung chính 15/600 · Plus Jakarta Sans</div><div class="muted" style="font-size:13px">Chú thích 13/500</div><div class="kf" style="font-size:28px">Baloo 2 cho giao diện của bé</div></div></section>
<section class="sl-card" style="flex:1 1 380px"><div class="card-t" style="margin-bottom:14px">Nút và chip</div><div class="wrap" style="gap:10px"><button class="sl-btn sl-btn-p">Chính</button><button class="sl-btn">Phụ</button><button class="sl-btn sl-btn-s">Nhấn mạnh</button><button class="sl-btn sl-btn-d">Nguy hiểm</button><button class="sl-btn sl-btn-g">Nhẹ</button></div><div class="wrap" style="gap:8px;margin-top:14px"><span class="chip t-p">Chính</span><span class="chip t-g">Thành công</span><span class="chip t-a">Cảnh báo</span><span class="chip t-r">Lỗi</span><span class="chip t-b">Thông tin</span><span class="chip t-v">AI</span></div><div class="sl-row" style="gap:16px;margin-top:16px"><span class="switch on"></span><span class="switch"></span><input class="chk" type="checkbox" checked><div class="seg"><span class="on">A</span><span>B</span></div></div></section></div>
<section class="sl-card"><div class="card-t" style="margin-bottom:14px">Biểu tượng (mặt nạ SVG theo màu chữ)</div><div class="wrap" style="gap:18px;color:var(--text-2)"><i class="ic ic-home ic-lg"></i><i class="ic ic-users ic-lg"></i><i class="ic ic-book ic-lg"></i><i class="ic ic-playc ic-lg"></i><i class="ic ic-clock ic-lg"></i><i class="ic ic-chart ic-lg"></i><i class="ic ic-file ic-lg"></i><i class="ic ic-shield ic-lg"></i><i class="ic ic-lock ic-lg"></i><i class="ic ic-bell ic-lg"></i><i class="ic ic-search ic-lg"></i><i class="ic ic-plus ic-lg"></i><i class="ic ic-check ic-lg"></i><i class="ic ic-flame ic-lg"></i><i class="ic ic-trophy ic-lg"></i><i class="ic ic-flag ic-lg"></i><i class="ic ic-star ic-lg"></i><i class="ic ic-heart ic-lg"></i><i class="ic ic-sparkles ic-lg"></i><i class="ic ic-target ic-lg"></i><i class="ic ic-pen ic-lg"></i><i class="ic ic-calc ic-lg"></i><i class="ic ic-flask ic-lg"></i><i class="ic ic-globe ic-lg"></i><i class="ic ic-moon ic-lg"></i><i class="ic ic-sun ic-lg"></i></div></section>
<div style="display:flex;flex-wrap:wrap;gap:16px"><section class="sl-card" style="flex:1 1 380px"><div class="card-t" style="margin-bottom:14px">Biểu mẫu</div><div class="sl-col" style="gap:12px"><input class="inp" value="Mặc định"><input class="inp f" value="Đang nhập"><input class="inp bad" value="Có lỗi"><span class="err">Thông báo lỗi rõ ràng, nói cách sửa.</span></div></section>
<section class="sl-card" style="flex:1 1 380px"><div class="card-t" style="margin-bottom:14px">Giao diện của bé</div><div data-app="kids" class="sl-col" style="gap:12px"><a class="k-btn">Học tiếp</a><span class="k-pill y"><i class="ic ic-clock"></i>Còn 28 phút</span><div class="k-card"><div class="kf" style="font-size:20px">Thẻ lớn, bo tròn</div><span class="k-note">Nút cao tối thiểu 52px</span></div></div></section></div>
<section class="sl-card"><div class="card-t" style="margin-bottom:10px">Nguyên tắc</div><ul style="margin:0;padding-left:20px;line-height:1.9;color:var(--text-2)"><li>Độ tương phản chữ đạt AA ở cả sáng và tối.</li><li>Vùng bấm tối thiểu 44px cho phụ huynh, 52px cho bé.</li><li>Trạng thái luôn có chữ, không chỉ dựa vào màu.</li><li>Giao diện bé dùng ít chữ, nhiều hình, một hành động chính mỗi màn.</li></ul></section></main>
