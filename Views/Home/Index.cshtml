@{
    ViewData["Title"] = """Trang giới thiệu SafeLearn Kids""";
    ViewData["Page"] = "index";
    ViewData["Area"] = "public";
    ViewData["AppStyle"] = "flex-direction:column;flex-wrap:nowrap";
}
<header style="display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:16px;padding:20px 56px">
<div class="brand" style="padding:0"><div class="brand-mark"><i class="ic ic-grad"></i></div><div class="brand-name">SafeLearn Kids</div></div>
<nav style="display:flex;flex-wrap:wrap;align-items:center;gap:8px">
<a class="sl-btn sl-btn-g" href="#tinh-nang">Tính năng</a>
<a class="sl-btn sl-btn-g" href="#an-toan">An toàn cho bé</a>
<span class="icbtn" aria-label="Giao diện sáng hoặc tối"><i class="ic ic-moon"></i></span>
<a class="sl-btn" href="~/login">Đăng nhập</a>
<a class="sl-btn sl-btn-p" href="~/register">Bắt đầu miễn phí</a>
</nav>
</header>
<section style="display:flex;flex-wrap:wrap;align-items:center;gap:48px;padding:28px 56px 36px">
<div style="flex:1 1 460px;min-width:0;display:flex;flex-direction:column;gap:22px">
<span class="chip t-p" style="align-self:flex-start;height:32px;padding:0 14px;font-size:13px"><i class="ic ic-sparkles"></i>Mới: quiz sau mỗi bài, ba mẹ duyệt trước</span>
<h1 style="font-size:60px;line-height:1.02;font-weight:800;letter-spacing:-.035em">Một nơi học vui,<br><span style="background:var(--grad);-webkit-background-clip:text;background-clip:text;color:transparent">an toàn</span> cho con</h1>
<p style="font-size:18px;line-height:1.6;color:var(--text-2);max-width:520px">Bài học theo môn, video chỉ từ nguồn ba mẹ đã duyệt, giờ học do ba mẹ đặt và báo cáo tuần để biết con tiến bộ ra sao.</p>
<div style="display:flex;flex-wrap:wrap;gap:12px"><a class="sl-btn sl-btn-p sl-btn-lg" href="~/register">Tạo tài khoản cho ba mẹ<i class="ic ic-arrowr"></i></a><a class="sl-btn sl-btn-lg" href="~/kids-picker"><i class="ic ic-smile"></i>Xem giao diện của bé</a></div>
<div style="display:flex;flex-wrap:wrap;gap:22px;color:var(--text-2);font-weight:600;font-size:13.5px"><span class="sl-row" style="gap:8px"><i class="ic ic-shield" style="color:var(--green)"></i>Nội dung ba mẹ duyệt</span><span class="sl-row" style="gap:8px"><i class="ic ic-clock" style="color:var(--blue)"></i>Giờ học do ba mẹ đặt</span><span class="sl-row" style="gap:8px"><i class="ic ic-lock" style="color:var(--violet)"></i>Dữ liệu tối thiểu</span></div>
</div>
<div class="mock" aria-hidden="true" style="flex:1 1 440px;min-width:0;position:relative;height:430px">
<div class="sl-card" style="position:absolute;left:0;top:30px;width:330px;padding:20px">
<div class="card-h" style="margin-bottom:12px"><span class="card-t">Hôm nay của Minh An</span><span class="chip t-g">Đúng giờ</span></div>
<div class="kpi"><span class="kpi-v">32<small style="font-size:15px;font-weight:700;color:var(--text-3)"> / 60 phút</small></span><div class="bar bar-l"><i style="width:53%"></i></div></div>
<div style="display:flex;align-items:flex-end;gap:8px;height:84px;margin-top:18px"><i style="flex:1;height:40%;border-radius:6px;background:var(--primary-soft)"></i><i style="flex:1;height:62%;border-radius:6px;background:var(--primary-soft)"></i><i style="flex:1;height:50%;border-radius:6px;background:var(--primary-soft)"></i><i style="flex:1;height:78%;border-radius:6px;background:var(--primary-soft)"></i><i style="flex:1;height:58%;border-radius:6px;background:var(--primary-soft)"></i><i style="flex:1;height:100%;border-radius:6px;background:var(--primary)"></i></div>
</div>
<div style="position:absolute;right:0;top:110px;width:290px;border-radius:28px;padding:16px;background:#FFF7E6;border:2px solid #F1DFB8;box-shadow:0 22px 50px rgba(36,27,75,.22);color:#241B4B">
<div style="height:140px;border-radius:20px;background:linear-gradient(135deg,#6A4CFF,#FF7AB6);display:flex;align-items:center;justify-content:center"><span style="width:60px;height:60px;border-radius:30px;background:#fff;color:#6A4CFF;display:flex;align-items:center;justify-content:center"><i class="ic ic-play ic-lg"></i></span></div>
<div class="kf" style="font-size:22px;margin:14px 4px 6px">Bảng nhân 5</div>
<div style="display:flex;gap:8px;padding:0 4px 4px"><span class="chip" style="background:#D8F4E8;color:#0B6B4A">Đã duyệt</span><span class="chip" style="background:#FFEFCF;color:#7A4B00">Còn 28 phút</span></div>
</div>
<span class="chip t-a" style="position:absolute;left:40px;bottom:30px;height:36px;padding:0 16px;font-size:13px;box-shadow:var(--shadow)"><i class="ic ic-flame"></i>6 ngày liên tiếp</span>
</div>
</section>
<section id="tinh-nang" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:18px;padding:8px 56px 28px">
<div class="sl-card"><div class="ib t-p" style="margin-bottom:14px"><i class="ic ic-book"></i></div><div class="card-t" style="margin-bottom:6px">Học theo môn và lộ trình</div><div class="card-s">Môn, bài, video, bài đọc và quiz sắp theo thứ tự cho từng lớp.</div></div>
<div id="an-toan" class="sl-card"><div class="ib t-g" style="margin-bottom:14px"><i class="ic ic-shield"></i></div><div class="card-t" style="margin-bottom:6px">An toàn nhiều lớp</div><div class="card-s">Nguồn duyệt, trình phát nhúng, giờ học phía máy chủ, PIN và báo cáo.</div></div>
<div class="sl-card"><div class="ib t-v" style="margin-bottom:14px"><i class="ic ic-chart"></i></div><div class="card-t" style="margin-bottom:6px">Báo cáo tuần rõ ràng</div><div class="card-s">Thời gian, điểm quiz và môn cần chú ý, gửi qua email mỗi tuần.</div></div>
<div class="sl-card"><div class="ib t-a" style="margin-bottom:14px"><i class="ic ic-sparkles"></i></div><div class="card-t" style="margin-bottom:6px">AI hỗ trợ, người quyết định</div><div class="card-s">AI gợi ý câu hỏi và điểm kênh, luôn chờ người duyệt.</div></div>
</section>
<footer style="margin-top:auto;display:flex;flex-wrap:wrap;justify-content:space-between;gap:12px;padding:20px 56px 28px;color:var(--text-3);font-size:13px;font-weight:600"><span>SafeLearn Kids · Đồ án Công nghệ phần mềm, Nhóm 16</span><span>Chính sách dữ liệu của trẻ em · Điều khoản · Liên hệ</span></footer>
