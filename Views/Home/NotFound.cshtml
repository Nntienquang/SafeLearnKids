@{
    var code = Context.Response.StatusCode;
    var (title, text, icon) = code switch
    {
        403 => ("Bạn không có quyền truy cập", "Tài khoản hiện tại không được dùng trang này.", "lock"),
        >= 500 => ("Đã có lỗi xảy ra", "Hệ thống chưa xử lý được yêu cầu. Vui lòng thử lại sau.", "flag"),
        _ => ("Không tìm thấy trang", "Đường dẫn có thể đã đổi hoặc không tồn tại.", "search")
    };
    ViewData["Title"] = title;
    ViewData["Page"] = code.ToString();
    ViewData["Area"] = "public";
    ViewData["AppStyle"] = "align-items:center;justify-content:center;padding:24px";
}
<main id="main" class="sl-card" style="max-width:480px;text-align:center;display:flex;flex-direction:column;gap:14px;align-items:center;padding:40px">
    <span class="ib t-p" style="width:64px;height:64px;border-radius:20px"><i class="ic ic-@icon ic-lg"></i></span>
    <h1 class="sl-h1">@title</h1>
    <p class="sub">@text</p>
    <a class="sl-btn sl-btn-p sl-btn-lg" href="~/">Về trang chủ</a>
</main>
