@{
    ViewData["Title"] = """Tuyển chọn kênh và AI đánh giá""";
    ViewData["Page"] = "admin-curate";
    ViewData["Nav"] = "curate";
    ViewData["Crumb"] = Html.Raw("""Quản trị · Nội dung""");
    ViewData["Heading"] = """Tuyển chọn kênh và AI đánh giá""";
    ViewData["Sub"] = """Duyệt kênh YouTube phụ huynh đề xuất, AI chỉ chấm sơ bộ (US-12, 32).""";
}
@section Actions {
<button class="sl-btn sl-btn-p" type="button"><i class="ic ic-sparkles"></i>Chấm lại bằng AI</button>
}
<div style="display:flex;flex-wrap:wrap;gap:16px;align-items:flex-start"><div class="sl-card" style="flex:2 1 520px;min-width:0;padding:6px 0"><table class="tbl"><thead><tr><th>Kênh đề xuất</th><th>Điểm AI</th><th>Trạng thái</th><th></th></tr></thead><tbody>
<tr><td><div class="b">Khoa học cho bé</div><div class="muted" style="font-size:12.5px">76 video · @@khoahoccho_be</div></td><td><div class="sl-row" style="gap:10px"><div class="bar" style="width:90px"><i style="width:88%;background:var(--green)"></i></div><span class="b">88</span></div></td><td><span class="chip t-a">Chờ duyệt</span></td><td style="text-align:right"><button class="sl-btn sl-btn-sm" type="button">Xem</button></td></tr><tr><td><div class="b">Vui học tiếng Anh</div><div class="muted" style="font-size:12.5px">54 video · @@vuihoctienganh</div></td><td><div class="sl-row" style="gap:10px"><div class="bar" style="width:90px"><i style="width:42%;background:var(--rose)"></i></div><span class="b">42</span></div></td><td><span class="chip t-r">Nghi vấn</span></td><td style="text-align:right"><button class="sl-btn sl-btn-sm" type="button">Xem</button></td></tr><tr><td><div class="b">Toán tư duy Kids</div><div class="muted" style="font-size:12.5px">110 video · @@toantuduy</div></td><td><div class="sl-row" style="gap:10px"><div class="bar" style="width:90px"><i style="width:91%;background:var(--green)"></i></div><span class="b">91</span></div></td><td><span class="chip t-g">Đã duyệt</span></td><td style="text-align:right"><button class="sl-btn sl-btn-sm" type="button">Xem</button></td></tr></tbody></table></div>
<div class="sl-card" style="flex:1 1 340px;min-width:0"><div class="sl-row" style="gap:8px;margin-bottom:10px"><span class="chip t-v"><i class="ic ic-sparkles"></i>Nhận xét AI</span></div><div class="b">Khoa học cho bé · 88/100</div><ul style="margin:10px 0 0;padding-left:18px;color:var(--text-2);line-height:1.8;font-size:14px"><li>Ngôn ngữ phù hợp lớp 2–4</li><li>Không có quảng cáo trong video mẫu</li><li>2 video cần xem lại: thí nghiệm lửa</li></ul>
<div class="banner t-a" style="font-size:13px;font-weight:600;margin-top:14px"><i class="ic ic-alert"></i>AI chỉ gợi ý. Quyết định cuối cùng thuộc về quản trị viên.</div>
<div class="sl-row" style="gap:8px;margin-top:14px"><button class="sl-btn sl-btn-d grow" type="button">Từ chối</button><button class="sl-btn sl-btn-p grow" type="button">Duyệt kênh</button></div></div></div>
