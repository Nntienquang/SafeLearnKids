}
<div style="display:flex;flex-wrap:wrap;gap:16px;align-items:flex-start"><div class="sl-card" style="flex:2 1 520px;min-width:0;padding:6px 0"><table class="tbl"><thead><tr><th>Nội dung</th><th>Người gửi</th><th>Mức</th><th></th></tr></thead><tbody>
<tr><td><div class="b">Vòng đời của bướm</div><div class="muted" style="font-size:12.5px">Có quảng cáo lạ</div></td><td class="muted">Phụ huynh · Thu Hà</td><td><span class="chip t-r">Khẩn</span></td><td style="text-align:right"><button class="sl-btn sl-btn-sm" type="button">Mở</button></td></tr><tr><td><div class="b">Greetings</div><div class="muted" style="font-size:12.5px">Âm thanh quá lớn</div></td><td class="muted">Phụ huynh · Lan</td><td><span class="chip t-a">Vừa</span></td><td style="text-align:right"><button class="sl-btn sl-btn-sm" type="button">Mở</button></td></tr><tr><td><div class="b">Động vật sống ở đâu?</div><div class="muted" style="font-size:12.5px">Hình ảnh gây sợ</div></td><td class="muted">Bé · Minh An</td><td><span class="chip t-a">Vừa</span></td><td style="text-align:right"><button class="sl-btn sl-btn-sm" type="button">Mở</button></td></tr></tbody></table></div>
