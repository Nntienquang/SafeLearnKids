@model AdminReportsViewModel
@{
    ViewData["Title"] = """Xử lý báo cáo nội dung""";
    ViewData["Page"] = "admin-reports-sql";
    ViewData["Nav"] = "reports";
    ViewData["Crumb"] = Html.Raw("""Quản trị · Vận hành""");
    ViewData["Heading"] = """Xử lý báo cáo nội dung""";
    ViewData["Sub"] = """Báo cáo từ bé và phụ huynh về nội dung không phù hợp (US-34).""";
    int Count(params string[] statuses) => statuses.Sum(status => Model.Counts.TryGetValue(status, out var count) ? count : 0);
}
@section Actions {
<div class="sl-row" style="gap:8px">
    <a class="sl-btn sl-btn-sm @(Model.Status == "open" ? "sl-btn-p" : "")" asp-action="Index" asp-route-status="open">Cần xử lý (@Count(ReportStatus.Open, ReportStatus.InReview))</a>
    <a class="sl-btn sl-btn-sm @(Model.Status == "done" ? "sl-btn-p" : "")" asp-action="Index" asp-route-status="done">Đã xử lý (@Count(ReportStatus.Resolved, ReportStatus.Dismissed))</a>
</div>
}
@if (TempData["Info"] is string info)
{
    <div class="banner t-g" role="status" style="margin-bottom:16px">@info</div>
}
@if (TempData["Error"] is string error)
{
    <div class="banner t-r" role="alert" style="margin-bottom:16px">@error</div>
}
<div class="sl-col" style="gap:16px">
    @foreach (var report in Model.Rows)
    {
        <div class="sl-card">
            <div class="sl-row" style="gap:12px;flex-wrap:wrap">
                <span class="ib t-r"><i class="ic ic-flag"></i></span>
                <div class="grow" style="min-width:200px">
                    <div class="b">@report.Target</div>
                    <div class="muted" style="font-size:12.5px">@ReportStatus.Reason(report.Reason)@(report.Comment is null ? "" : " · \"" + report.Comment + "\"") · @report.From · @report.CreatedAt.ToLocalTime().ToString("dd/MM HH:mm")</div>
                </div>
                <span class="chip @ReportStatus.Tone(report.Status)">@ReportStatus.Label(report.Status)</span>
                @if (report.LessonId is { } lessonId)
                {
                    <a class="sl-btn sl-btn-sm" asp-controller="Catalog" asp-action="EditLesson" asp-route-id="@lessonId">Mở bài</a>
                }
                @if (report.VideoKey is not null)
                {
                    <a class="sl-btn sl-btn-sm" href="https://www.youtube.com/watch?v=@report.VideoKey" target="_blank" rel="noopener noreferrer">Xem video</a>
                }
            </div>
            @if (report.Resolution is not null)
            {
                <p style="margin:12px 0 0;font-size:13.5px">Kết quả: @report.Resolution@(report.HandledBy is null ? "" : " · " + report.HandledBy)</p>
            }
            @if (report.Status is ReportStatus.Open or ReportStatus.InReview)
            {
                <form asp-action="Handle" asp-route-id="@report.Id" method="post" style="display:flex;flex-direction:column;gap:10px;margin-top:14px">
                    <input type="hidden" name="rowVersion" value="@report.RowVersion" />
                    <label class="lab" for="resolution-@report.Id">Kết quả xử lý (gửi cho gia đình)</label>
                    <textarea class="inp ta" id="resolution-@report.Id" name="resolution" rows="2" maxlength="500"></textarea>
                    <div class="sl-row" style="gap:8px;flex-wrap:wrap;justify-content:flex-end">
                        @if (report.Status == ReportStatus.Open)
                        {
                            <button class="sl-btn" type="submit" name="action" value="review">Nhận xem</button>
                        }
                        <button class="sl-btn" type="submit" name="action" value="keep">Giữ nội dung</button>
                        <button class="sl-btn sl-btn-d" type="submit" name="action" value="remove">@(report.VideoId is not null ? "Chặn video" : "Gỡ bài học")</button>
                    </div>
                </form>
            }
        </div>
    }
    @if (Model.Rows.Count == 0)
    {
        <div class="empty">Không có báo cáo nào ở đây.</div>
    }
</div>
