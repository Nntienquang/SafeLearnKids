@model AuditViewModel
@{
    ViewData["Title"] = """Nhật ký""";
    ViewData["Page"] = "admin-audit-sql";
    ViewData["Nav"] = "audit";
    ViewData["Crumb"] = Html.Raw("""Quản trị · Vận hành""");
    ViewData["Heading"] = """Nhật ký thao tác và đăng nhập""";
    ViewData["Sub"] = """Mọi thao tác quản trị, thay đổi dữ liệu và lần đăng nhập đều được ghi lại để truy vết (US-51).""";
    var logins = Model.Tab == "logins";
    var query = new Dictionary<string, string?> { ["tab"] = Model.Tab, ["q"] = Model.Q, ["type"] = Model.Action, ["result"] = Model.Result,
        ["from"] = Model.From?.ToString("yyyy-MM-dd"), ["to"] = Model.To?.ToString("yyyy-MM-dd") };
}
@section Actions {
<a class="sl-btn" asp-action="Export" asp-all-route-data="@query.Where(pair => pair.Value is not null).ToDictionary(pair => pair.Key, pair => pair.Value!)"><i class="ic ic-download"></i>Xuất CSV</a>
}
<nav class="sl-row" style="gap:8px;margin-bottom:16px" aria-label="Loại nhật ký">
    <a class="sl-btn sl-btn-sm @(logins ? "" : "sl-btn-p")" asp-action="Index" asp-route-tab="actions" aria-current="@(logins ? null : "page")">Thao tác</a>
    <a class="sl-btn sl-btn-sm @(logins ? "sl-btn-p" : "")" asp-action="Index" asp-route-tab="logins" aria-current="@(logins ? "page" : null)">Đăng nhập</a>
</nav>
<form method="get" asp-action="Index" class="sl-card sl-row" style="gap:10px;flex-wrap:wrap;margin-bottom:16px">
    <input type="hidden" name="tab" value="@Model.Tab" />
    <label class="sr-only" for="audit-q">Tìm</label>
    <input class="inp grow" id="audit-q" name="q" value="@Model.Q" style="min-width:200px" placeholder="@(logins ? "Email hoặc IP" : "Email người thực hiện, chi tiết, đối tượng")" />
    @if (logins)
    {
        <label class="sr-only" for="audit-result">Kết quả</label>
        <select class="inp" id="audit-result" name="result" style="width:auto">
            <option value="">Mọi kết quả</option>
            <option value="success" selected="@(Model.Result == "success")">Thành công</option>
            <option value="failed" selected="@(Model.Result == "failed")">Thất bại</option>
        </select>
    }
    else
    {
        <label class="sr-only" for="audit-action">Thao tác</label>
        <select class="inp" id="audit-action" name="type" style="width:auto">
            <option value="">Mọi thao tác</option>
            @foreach (var item in Model.Actions)
            {
                <option value="@item" selected="@(Model.Action == item)">@item</option>
            }
        </select>
    }
    <label class="sl-row" style="gap:6px;font-size:13px">Từ <input class="inp" type="date" name="from" value="@Model.From?.ToString("yyyy-MM-dd")" style="width:auto" /></label>
    <label class="sl-row" style="gap:6px;font-size:13px">Đến <input class="inp" type="date" name="to" value="@Model.To?.ToString("yyyy-MM-dd")" style="width:auto" /></label>
    <button class="sl-btn sl-btn-p" type="submit"><i class="ic ic-filter"></i>Lọc</button>
</form>
<div class="sl-card" style="padding:6px 0;overflow-x:auto">
    <div class="muted" style="padding:10px 18px 0;font-size:12.5px">@Model.Matching dòng</div>
    <table class="tbl">
        @if (logins)
        {
            <thead><tr><th>Thời gian</th><th>Email</th><th>Kết quả</th><th>IP</th><th>Trình duyệt</th></tr></thead>
            <tbody>
                @foreach (var row in Model.Logins)
                {
                    <tr>
                        <td class="muted">@row.At.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</td>
                        <td><span class="b">@row.Tried</span>@if (row.User is null) {<div class="muted" style="font-size:12px">không có tài khoản</div>}</td>
                        <td><span class="chip @(row.Succeeded ? "t-g" : "t-r")">@(row.Succeeded ? "Thành công" : "Thất bại")</span>@if (row.Reason is not null) {<div class="muted" style="font-size:12px">@row.Reason</div>}</td>
                        <td class="muted">@row.Ip</td>
                        <td class="muted" style="max-width:280px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="@row.Agent">@row.Agent</td>
                    </tr>
                }
            </tbody>
        }
        else
        {
            <thead><tr><th>Thời gian</th><th>Người thực hiện</th><th>Thao tác</th><th>Đối tượng</th><th>Chi tiết</th><th>IP</th></tr></thead>
            <tbody>
                @foreach (var row in Model.Audits)
                {
                    <tr>
                        <td class="muted">@row.At.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</td>
                        <td>@(row.Actor ?? "hệ thống")</td>
                        <td><span class="chip t-n">@row.Action</span></td>
                        <td>@row.EntityType@(row.EntityId is null ? "" : " #" + row.EntityId)</td>
                        <td style="max-width:360px;overflow-wrap:anywhere">@row.Detail</td>
                        <td class="muted">@row.Ip</td>
                    </tr>
                }
            </tbody>
        }
    </table>
    @if (Model.Matching == 0)
    {
        <div class="empty" style="margin:12px 18px">Không có dòng nào khớp bộ lọc.</div>
    }
</div>
@if (Model.TotalPages > 1)
{
    <nav class="sl-row" style="gap:8px;justify-content:center;margin-top:16px;flex-wrap:wrap" aria-label="Phân trang">
        @if (Model.Page > 1)
        {
            <a class="sl-btn sl-btn-sm" asp-action="Index" asp-all-route-data="@(new Dictionary<string, string>(query.Where(pair => pair.Value is not null).ToDictionary(pair => pair.Key, pair => pair.Value!)) { ["page"] = (Model.Page - 1).ToString() })">Trang trước</a>
        }
        <span class="muted" style="align-self:center">Trang @Model.Page / @Model.TotalPages</span>
        @if (Model.Page < Model.TotalPages)
        {
            <a class="sl-btn sl-btn-sm" asp-action="Index" asp-all-route-data="@(new Dictionary<string, string>(query.Where(pair => pair.Value is not null).ToDictionary(pair => pair.Key, pair => pair.Value!)) { ["page"] = (Model.Page + 1).ToString() })">Trang sau</a>
        }
    </nav>
}
