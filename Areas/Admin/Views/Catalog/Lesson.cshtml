@{
    ViewData["Title"] = """Soạn bài học: Bảng nhân 5""";
    ViewData["Page"] = "admin-lesson";
    ViewData["Nav"] = "lesson";
    ViewData["Crumb"] = Html.Raw("""Quản trị · Nội dung""");
    ViewData["Heading"] = """Soạn bài học: Bảng nhân 5""";
    ViewData["Sub"] = """Gắn video, bài đọc và quiz vào bài (US-07, 08).""";
}
@section Actions {
<button class="sl-btn" type="button">Lưu nháp</button><button class="sl-btn sl-btn-p" type="button">Xuất bản</button>
}
<div style="display:flex;flex-wrap:wrap;gap:16px;align-items:flex-start"><div class="sl-col" style="flex:2 1 520px;min-width:0;gap:16px">
<div class="sl-card" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:16px"><div class="field" style="grid-column:1/-1"><label class="lab" for="al1">Tên bài</label><input id="al1" class="inp f" value="Bảng nhân 5"></div><div class="field"><span class="lab">Môn</span><div class="inp" style="display:flex;justify-content:space-between">Toán<i class="ic ic-chevd"></i></div></div><div class="field"><span class="lab">Lớp</span><div class="inp" style="display:flex;justify-content:space-between">Lớp 3<i class="ic ic-chevd"></i></div></div><div class="field" style="grid-column:1/-1"><label class="lab" for="al2">Mục tiêu</label><textarea id="al2" class="inp ta">Bé thuộc bảng nhân 5 và nhận ra quy luật chữ số tận cùng.</textarea></div></div>
<div class="sl-card"><div class="card-h"><div class="card-t">Nội dung bài</div><button class="sl-btn sl-btn-sm" type="button"><i class="ic ic-plus"></i>Thêm nội dung</button></div>
<div class="sl-row" style="gap:12px;padding:12px;border-radius:16px;background:var(--surface-2);margin-top:10px"><i class="ic ic-menu" style="color:var(--text-3)"></i><span class="ib t-p"><i class="ic ic-playc"></i></span><div class="grow"><div class="b">Video: Bảng nhân 5</div><div class="muted" style="font-size:12.5px">Học Toán Vui · 10 phút</div></div><span class="icbtn" style="width:36px;height:36px"><i class="ic ic-edit"></i></span><span class="icbtn" style="width:36px;height:36px"><i class="ic ic-trash"></i></span></div><div class="sl-row" style="gap:12px;padding:12px;border-radius:16px;background:var(--surface-2);margin-top:10px"><i class="ic ic-menu" style="color:var(--text-3)"></i><span class="ib t-t"><i class="ic ic-book"></i></span><div class="grow"><div class="b">Bài đọc: Quy luật của bảng nhân 5</div><div class="muted" style="font-size:12.5px">Văn bản · 3 phút</div></div><span class="icbtn" style="width:36px;height:36px"><i class="ic ic-edit"></i></span><span class="icbtn" style="width:36px;height:36px"><i class="ic ic-trash"></i></span></div><div class="sl-row" style="gap:12px;padding:12px;border-radius:16px;background:var(--surface-2);margin-top:10px"><i class="ic ic-menu" style="color:var(--text-3)"></i><span class="ib t-a"><i class="ic ic-target"></i></span><div class="grow"><div class="b">Quiz: 5 câu</div><div class="muted" style="font-size:12.5px">Đạt khi đúng 3/5</div></div><span class="icbtn" style="width:36px;height:36px"><i class="ic ic-edit"></i></span><span class="icbtn" style="width:36px;height:36px"><i class="ic ic-trash"></i></span></div></div></div>
<div class="sl-col" style="flex:1 1 300px;min-width:0;gap:16px"><div class="sl-card"><div class="card-t" style="margin-bottom:10px">Xuất bản</div><div class="sl-row" style="justify-content:space-between;padding:8px 0"><span class="b">Trạng thái</span><span class="chip t-a">Bản nháp</span></div><div class="banner t-b" style="font-size:13px;font-weight:600"><i class="ic ic-info"></i>Cần ít nhất 1 nội dung và 1 quiz đã duyệt.</div></div>
<div class="sl-card"><div class="card-t" style="margin-bottom:10px">Xem trước của bé</div><div style="height:140px;border-radius:20px;background:linear-gradient(135deg,#6A4CFF,#FF7AB6);display:flex;align-items:center;justify-content:center;color:#fff"><i class="ic ic-play ic-xl"></i></div></div></div></div>
