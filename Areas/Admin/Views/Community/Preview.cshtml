@model CommunityPreviewViewModel
@{
    var lesson = Model.Lesson;
    ViewData["Title"] = "Duyệt bài cộng đồng";
    ViewData["Page"] = "admin-community-sql";
    ViewData["Nav"] = "community";
    ViewData["Crumb"] = Html.Raw("""<a href="/admin-community">Bài cộng đồng</a>""");
    ViewData["Heading"] = lesson.Title;
    ViewData["Sub"] = $"{lesson.Subject} · Lớp {lesson.Grade} · {LessonKind.TypeLabel(Model.LessonType)} · {Model.DurationMin} phút · đóng góp bởi {lesson.Author}";
}
@if (TempData["Error"] is string error)
{
    <div class="banner t-r" role="alert" style="margin-bottom:16px">@error</div>
}
<div style="display:flex;flex-wrap:wrap;gap:16px;align-items:flex-start">
    <div class="sl-col" style="flex:2 1 520px;min-width:0;gap:16px">
        <div class="sl-card">
            <div class="card-t" style="margin-bottom:6px">Mục tiêu</div>
            <p class="sub" style="margin:0">@(Model.Summary ?? "Không có mục tiêu.")</p>
        </div>
        <div class="sl-card">
            <div class="card-t">Nội dung (bé sẽ thấy đúng như dưới đây)</div>
            @foreach (var content in Model.Contents)
            {
                <section style="padding:14px 0;border-top:1px solid var(--line);margin-top:10px">
                    <div class="b" style="margin-bottom:8px">@LessonKind.ContentLabel(content.Kind)@(content.Title is null ? "" : ": " + content.Title)</div>
                    @switch (content.Kind)
                    {
                        case "Reading":
                            <div style="white-space:pre-line;line-height:1.7">@content.Body</div>
                            break;
                        case "Video":
                            <div style="position:relative;padding-top:56.25%;border-radius:16px;overflow:hidden;background:#000">
                                <iframe src="https://www.youtube-nocookie.com/embed/@(content.VideoId)?rel=0&amp;modestbranding=1" title="@(content.Title ?? lesson.Title)"
                                        style="position:absolute;inset:0;width:100%;height:100%;border:0" loading="lazy"
                                        referrerpolicy="strict-origin-when-cross-origin" sandbox="allow-scripts allow-same-origin allow-presentation"
                                        allow="encrypted-media; picture-in-picture" allowfullscreen></iframe>
                            </div>
                            break;
                        case "Image":
                            <img src="@content.FileUrl" alt="@(content.Title ?? lesson.Title)" style="max-width:100%;border-radius:12px" loading="lazy" />
                            break;
                        default:
                            <a class="sl-btn sl-btn-sm" href="@content.FileUrl" target="_blank" rel="noopener"><i class="ic ic-file"></i>Mở @(content.FileName ?? "tài liệu")</a>
                            break;
                    }
                </section>
            }
            @if (Model.Contents.Count == 0)
            {
                <div class="empty" style="margin-top:10px">Bài chưa có nội dung phát được.</div>
            }
        </div>
        <div class="sl-card">
            <div class="card-t">Câu hỏi (@Model.Questions.Count)</div>
            @foreach (var question in Model.Questions)
            {
                <div style="padding:10px 0;border-top:1px solid var(--line);margin-top:8px">
                    <div class="b">@question.Text</div>
                    <div class="muted" style="font-size:12.5px">@string.Join(" · ", question.Answers.Select(answer => (answer.Correct ? "✔ " : "") + answer.Text))@(question.Explanation is null ? "" : " — " + question.Explanation)</div>
                </div>
            }
        </div>
    </div>
    <div class="sl-col" style="flex:1 1 300px;min-width:0;gap:16px">
        <div class="sl-card">
            <div class="card-t" style="margin-bottom:8px">Quyết định</div>
            <span class="chip @LessonAccess.ShareTone(lesson.ShareStatus)">@LessonAccess.ShareLabel(lesson.ShareStatus)</span>
            @if (lesson.ShareNote is not null)
            {
                <p style="margin:8px 0 0;font-size:13px">@lesson.ShareNote</p>
            }
            @if (lesson.ShareStatus is LessonAccess.Pending or LessonAccess.Approved)
            {
                <form asp-action="Decide" asp-route-id="@lesson.Id" method="post" class="sl-col" style="gap:8px;margin-top:12px">
                    <label class="lab" for="note">Ghi chú gửi gia đình (bắt buộc khi từ chối hoặc gỡ)</label>
                    <textarea class="inp ta" id="note" name="note" rows="3" maxlength="500"></textarea>
                    <div class="sl-row" style="gap:8px;flex-wrap:wrap">
                        @if (lesson.ShareStatus == LessonAccess.Pending)
                        {
                            <button class="sl-btn" type="submit" name="decision" value="reject">Từ chối</button>
                            <button class="sl-btn sl-btn-p" type="submit" name="decision" value="approve"><i class="ic ic-check"></i>Duyệt lên cộng đồng</button>
                        }
                        else
                        {
                            <button class="sl-btn sl-btn-d" type="submit" name="decision" value="withdraw">Gỡ khỏi cộng đồng</button>
                        }
                    </div>
                </form>
            }
            <ul style="margin:14px 0 0;padding-left:18px;font-size:13px;line-height:1.7">
                <li>Nội dung đúng, phù hợp lứa tuổi, không quảng cáo.</li>
                <li>Video đều là video đã duyệt (bài chỉ chọn được video đã duyệt).</li>
                <li>Câu hỏi có đáp án đúng và giải thích dễ hiểu.</li>
            </ul>
        </div>
    </div>
</div>
