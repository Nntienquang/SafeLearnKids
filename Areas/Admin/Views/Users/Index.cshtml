@model AdminUsersViewModel
@{
    ViewData["Title"] = """Người dùng""";
    ViewData["Page"] = "admin-users";
    ViewData["Nav"] = "users";
    ViewData["Crumb"] = Html.Raw("""Quản trị · Vận hành""");
    ViewData["Heading"] = """Người dùng""";
    ViewData["Sub"] = """Thêm, sửa, xóa, khóa và phân quyền tài khoản (US-30).""";
    var filter = new Dictionary<string, string?> { ["q"] = Model.Q, ["status"] = Model.Status, ["role"] = Model.Role };
}
@section Actions {
<a class="sl-btn" asp-action="Export" asp-all-route-data="filter!"><i class="ic ic-download"></i>Xuất danh sách</a>
<a class="sl-btn sl-btn-p" asp-action="Create">Thêm người dùng</a>
}
@if (TempData["Info"] is string info)
{
    <div class="banner t-g" role="status" style="margin-bottom:16px">@info</div>
}
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:16px;margin-bottom:16px">
    <div class="sl-card kpi"><span class="muted b">Tổng tài khoản</span><div class="kpi-v">@Model.Total</div></div>
    <div class="sl-card kpi"><span class="muted b">Hoạt động</span><div class="kpi-v">@Model.Active</div></div>
    <div class="sl-card kpi"><span class="muted b">Chờ xác minh</span><div class="kpi-v">@Model.Pending</div></div>
    <div class="sl-card kpi"><span class="muted b">Bị khóa</span><div class="kpi-v">@Model.Locked</div></div>
</div>
<form method="get" asp-action="Index" class="sl-row" style="gap:12px;margin-bottom:16px;flex-wrap:wrap">
    <input class="inp inp-sm grow" style="min-width:220px" type="search" name="q" value="@Model.Q" maxlength="256" aria-label="Tìm tài khoản" placeholder="Tìm theo tên hoặc email" />
    <select class="inp inp-sm" style="width:auto" name="status" aria-label="Lọc theo trạng thái">
        <option value="">Mọi trạng thái</option>
        <option value="@AdminUserStatus.Active" selected="@(Model.Status == AdminUserStatus.Active)">Hoạt động</option>
        <option value="@AdminUserStatus.Pending" selected="@(Model.Status == AdminUserStatus.Pending)">Chờ xác minh</option>
        <option value="@AdminUserStatus.Locked" selected="@(Model.Status == AdminUserStatus.Locked)">Bị khóa</option>
    </select>
    <select class="inp inp-sm" style="width:auto" name="role" aria-label="Lọc theo vai trò">
        <option value="">Mọi vai trò</option>
        @foreach (var role in Model.RoleOptions)
        {
            <option value="@role" selected="@(Model.Role == role)">@role</option>
        }
    </select>
    <button class="sl-btn sl-btn-p" type="submit"><i class="ic ic-search"></i>Tìm</button>
</form>
<div class="sl-card" style="padding:6px 0;overflow-x:auto"><table class="tbl"><thead><tr><th>Tài khoản</th><th>Vai trò</th><th>Số bé</th><th>Tham gia</th><th>Đăng nhập gần nhất</th><th>Trạng thái</th><th></th></tr></thead><tbody>
@foreach (var row in Model.Rows)
{
    <tr>
        <td><div class="sl-row" style="gap:12px"><partial name="_Avatar" model="@(new AvatarViewModel(row.AvatarUrl, row.Name, "av-s", "var(--grad)"))" /><div><div class="b">@row.Name</div><div class="muted" style="font-size:12.5px">@row.Email</div></div></div></td>
        <td>@(row.Roles.Count > 0 ? string.Join(", ", row.Roles) : "—")</td>
        <td class="b">@row.Children</td>
        <td class="muted">@row.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</td>
        <td class="muted">@(row.LastLoginAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "Chưa có")</td>
        <td><partial name="_StatusChip" model="row.Status" /></td>
        <td style="text-align:right"><a class="sl-btn sl-btn-sm" asp-action="Details" asp-route-id="@row.Id">Chi tiết</a></td>
    </tr>
}
@if (Model.Rows.Count == 0)
{
    <tr><td colspan="7"><div class="empty">Không tìm thấy tài khoản</div></td></tr>
}
</tbody></table></div>
@if (Model.TotalPages > 1)
{
    <div class="sl-row" style="gap:10px;margin-top:16px;justify-content:flex-end;align-items:center">
        <span class="muted">Trang @Model.Page/@Model.TotalPages · @Model.Matching tài khoản</span>
        @if (Model.Page > 1)
        {
            <a class="sl-btn sl-btn-sm" asp-action="Index" asp-all-route-data="filter!" asp-route-page="@(Model.Page - 1)">Trước</a>
        }
        @if (Model.Page < Model.TotalPages)
        {
            <a class="sl-btn sl-btn-sm" asp-action="Index" asp-all-route-data="filter!" asp-route-page="@(Model.Page + 1)">Sau</a>
        }
    </div>
}
