@model AdminUserDetailViewModel
@{
    var user = Model.User;
    ViewData["Title"] = user.Name;
    ViewData["Page"] = "admin-users";
    ViewData["Nav"] = "users";
    ViewData["Crumb"] = Html.Raw("""Quản trị · Người dùng""");
    ViewData["Heading"] = user.Name;
    ViewData["Sub"] = user.Email;
    var locked = Model.Disabled || Model.LockedOutUntil is not null;
    var currentRole = user.Roles.Contains("Admin") ? "Admin" : user.Roles.Contains("Parent") ? "Parent" : "";
    string ActionLabel(string action) => action switch
    {
        "LockUser" => "Khóa tài khoản",
        "UnlockUser" => "Mở khóa tài khoản",
        "ChangeRole" => "Đổi vai trò",
        "CreateUser" => "Tạo tài khoản",
        "UpdateUser" => "Sửa thông tin",
        "ChangeAvatar" => "Đổi ảnh đại diện",
        "RemoveAvatar" => "Gỡ ảnh đại diện",
        "ResendConfirmation" => "Gửi lại email xác minh",
        "SendPasswordReset" => "Gửi email đặt lại mật khẩu",
        _ => action
    };
    string FailLabel(string? reason) => reason switch
    {
        "InvalidCredentials" => "Sai thông tin đăng nhập",
        "LockedOut" => "Đang tạm khóa",
        "EmailNotConfirmed" => "Chưa xác minh email",
        "Disabled" => "Tài khoản bị khóa",
        _ => "Không thành công"
    };
}
@section Actions {
<a class="sl-btn" asp-action="Index"><i class="ic ic-arrowl"></i>Danh sách</a>
<a class="sl-btn sl-btn-p" asp-action="Edit" asp-route-id="@user.Id"><i class="ic ic-edit"></i>Sửa thông tin</a>
}
@if (TempData["Info"] is string info)
{
    <div class="banner t-g" role="status" style="margin-bottom:16px">@info</div>
}
@if (TempData["Error"] is string error)
{
    <div class="banner t-r" role="alert" style="margin-bottom:16px">@error</div>
}
<div class="ud-grid">
    <div class="sl-card">
        <div class="ud-head">
            <partial name="_Avatar" model="@(new AvatarViewModel(user.AvatarUrl, user.Name, "av-l", "var(--grad)"))" />
            <div class="grow">
                <div class="sl-row" style="gap:8px;flex-wrap:wrap">
                    @if (user.Roles.Count > 0)
                    {
                        <span class="chip t-p">@string.Join(", ", user.Roles)</span>
                    }
                    <partial name="_StatusChip" model="user.Status" />
                </div>
            </div>
        </div>
        <dl class="ud-facts">
            <div class="ud-fact"><dt>Email</dt><dd>@(Model.EmailConfirmed ? "Đã xác minh" : "Chưa xác minh")</dd></div>
            <div class="ud-fact"><dt>Số bé</dt><dd>@user.Children</dd></div>
            <div class="ud-fact"><dt>Tham gia</dt><dd>@user.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd></div>
            <div class="ud-fact"><dt>Đăng nhập gần nhất</dt><dd>@(user.LastLoginAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "Chưa có")</dd></div>
            @if (Model.LockedOutUntil is { } until)
            {
                <div class="ud-fact"><dt>Tạm khóa đến</dt><dd>@until.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd></div>
            }
        </dl>
    </div>
    <div class="sl-card">
        <div class="card-h" style="margin-bottom:6px"><div class="card-t">Thao tác</div></div>
        @if (Model.IsSelf)
        {
            <p class="muted ud-hint">Đây là tài khoản của bạn nên không thể tự khóa, xóa hoặc đổi vai trò.</p>
        }
        @if (Model.RoleEditable && !Model.IsSelf)
        {
            <div class="ud-sec">
                <div class="ud-lab">Vai trò</div>
                <form asp-action="SetRole" asp-route-id="@user.Id" method="post" class="sl-row" style="gap:10px" data-confirm="Đổi vai trò của @user.Name?" data-text="Tài khoản sẽ bị đăng xuất khỏi mọi phiên. Người được chuyển sang Admin sẽ có toàn quyền quản trị." data-ok-label="Đổi vai trò" data-danger="true">
                    <select class="inp inp-sm grow" name="role" aria-label="Vai trò">
                        <option value="Parent" selected="@(currentRole == "Parent")">Parent</option>
                        <option value="Admin" selected="@(currentRole == "Admin")">Admin</option>
                    </select>
                    <button class="sl-btn" type="submit">Lưu vai trò</button>
                </form>
            </div>
        }
        else if (!Model.RoleEditable)
        {
            <div class="ud-sec"><div class="ud-lab">Vai trò</div><p class="muted ud-hint">Vai trò @string.Join(", ", user.Roles) không chỉnh được tại đây.</p></div>
        }
        @if (!Model.Disabled)
        {
            <div class="ud-sec">
                <div class="ud-lab">Email</div>
                @if (Model.EmailConfirmed)
                {
                    <form asp-action="SendReset" asp-route-id="@user.Id" method="post"><button class="sl-btn sl-btn-block" type="submit"><i class="ic ic-mail"></i>Gửi email đặt lại mật khẩu</button></form>
                }
                else
                {
                    <form asp-action="ResendConfirmation" asp-route-id="@user.Id" method="post"><button class="sl-btn sl-btn-block" type="submit"><i class="ic ic-mail"></i>Gửi lại email xác minh</button></form>
                }
            </div>
        }
        @if (locked || !Model.IsSelf)
        {
            <div class="ud-sec">
                <div class="ud-lab">Quyền truy cập</div>
                <div class="ud-acts">
                    @if (locked)
                    {
                        <form asp-action="Unlock" asp-route-id="@user.Id" method="post" data-confirm="Mở khóa @user.Name?" data-text="Tài khoản sẽ đăng nhập lại được." data-ok-label="Mở khóa">
                            <button class="sl-btn sl-btn-block" type="submit">Mở khóa</button>
                        </form>
                    }
                    else
                    {
                        <form asp-action="Lock" asp-route-id="@user.Id" method="post" data-confirm="Khóa @user.Name?" data-text="Tài khoản sẽ không đăng nhập được và mọi phiên hiện tại bị kết thúc." data-ok-label="Khóa tài khoản" data-danger="true">
                            <button class="sl-btn sl-btn-d sl-btn-block" type="submit"><i class="ic ic-lock"></i>Khóa tài khoản</button>
                        </form>
                    }
                    @if (!Model.IsSelf)
                    {
                        <form asp-action="Delete" asp-route-id="@user.Id" method="post" data-confirm="Xóa vĩnh viễn @user.Name?" data-text="Không thể hoàn tác. Tài khoản đã có hồ sơ bé hoặc dữ liệu liên quan sẽ không xóa được." data-ok-label="Xóa tài khoản" data-danger="true">
                            <button class="sl-btn sl-btn-d sl-btn-block" type="submit"><i class="ic ic-trash"></i>Xóa tài khoản</button>
                        </form>
                    }
                </div>
            </div>
        }
    </div>
</div>
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:16px">
    <div class="sl-card">
        <div class="card-h"><div class="card-t">Lịch sử đăng nhập</div></div>
        @foreach (var login in Model.Logins)
        {
            <div class="sl-row" style="gap:14px;padding:12px 0;border-top:1px solid var(--line)"><div class="grow"><div class="b">@(login.Succeeded ? "Thành công" : FailLabel(login.FailReason))</div><div class="muted" style="font-size:12.5px">@login.IpAddress</div></div><span class="muted" style="font-size:12.5px">@login.At.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span></div>
        }
        @if (Model.Logins.Count == 0)
        {
            <div class="empty">Chưa có lượt đăng nhập</div>
        }
    </div>
    <div class="sl-card">
        <div class="card-h"><div class="card-t">Nhật ký quản trị</div></div>
        @foreach (var entry in Model.Audit)
        {
            <div class="sl-row" style="gap:14px;padding:12px 0;border-top:1px solid var(--line)"><div class="grow"><div class="b">@ActionLabel(entry.Action)@(entry.Detail is null ? "" : $": {entry.Detail}")</div><div class="muted" style="font-size:12.5px">@entry.Actor</div></div><span class="muted" style="font-size:12.5px">@entry.At.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span></div>
        }
        @if (Model.Audit.Count == 0)
        {
            <div class="empty">Chưa có thao tác quản trị</div>
        }
    </div>
</div>
