@model PinViewModel
@{
    ViewData["Title"] = """Mã PIN và chế độ trẻ""";
    ViewData["Page"] = "pin-sql";
    ViewData["Nav"] = "pin";
    ViewData["Crumb"] = Html.Raw("""Phụ huynh · Bảo vệ""");
    ViewData["Heading"] = """Mã PIN và chế độ trẻ""";
    ViewData["Sub"] = """PIN của ba mẹ giữ bé trong chế độ học (US-50). PIN riêng của từng bé giữ hồ sơ của bé cho riêng bé (US-08).""";
}
@if (TempData["Info"] is string info)
{
    <div class="banner t-g" role="status" style="margin-bottom:16px">@info</div>
}
@if (TempData["ChildPinError"] is string childPinError)
{
    <div class="banner t-r" role="alert" style="margin-bottom:16px">@childPinError</div>
}
<div style="display:flex;flex-wrap:wrap;gap:16px;align-items:flex-start">
    <form method="post" asp-action="Save" class="sl-card acc-form" style="flex:1 1 420px;min-width:0">
        <div class="card-t">@(Model.HasPin ? "Đổi mã PIN" : "Đặt mã PIN")</div>
        <p class="muted" style="margin:0;font-size:13px">@(Model.HasPin ? $"PIN được đặt lần gần nhất lúc {Model.UpdatedAt?.ToLocalTime():dd/MM/yyyy HH:mm}." : "Chưa có PIN: khi rời chế độ trẻ, ba mẹ phải nhập mật khẩu tài khoản.")</p>
        <div asp-validation-summary="ModelOnly" class="err" role="alert"></div>
        <section class="acc-sec">
            <div style="display:flex;flex-wrap:wrap;gap:12px">
                <div class="field" style="flex:1 1 140px">
                    <label class="lab" for="pin-new">PIN mới (4 số)</label>
                    <input class="inp" id="pin-new" name="Pin" type="password" inputmode="numeric" pattern="\d{4}" maxlength="4" autocomplete="new-password" required />
                    @Html.ValidationMessage("Pin", new { @class = "err" })
                </div>
                <div class="field" style="flex:1 1 140px">
                    <label class="lab" for="pin-confirm">Nhập lại PIN</label>
                    <input class="inp" id="pin-confirm" name="ConfirmPin" type="password" inputmode="numeric" pattern="\d{4}" maxlength="4" autocomplete="new-password" required />
                    @Html.ValidationMessage("ConfirmPin", new { @class = "err" })
                </div>
            </div>
            <div class="field">
                <label class="lab" for="pin-password">Mật khẩu tài khoản</label>
                <input class="inp" id="pin-password" name="Password" type="password" autocomplete="current-password" required />
                @Html.ValidationMessage("Password", new { @class = "err" })
            </div>
        </section>
        <div class="acc-foot"><button class="sl-btn sl-btn-p" type="submit"><i class="ic ic-key"></i>@(Model.HasPin ? "Đổi PIN" : "Đặt PIN")</button></div>
    </form>
    <div class="sl-card" style="flex:1 1 320px;min-width:0">
        <div class="card-t" style="margin-bottom:10px">Chế độ trẻ hoạt động thế nào</div>
        <ul style="margin:0;padding-left:18px;line-height:1.8;font-size:13.5px">
            <li>Bấm <b>Chế độ trẻ</b> rồi chọn bé. Từ lúc đó mọi trang của ba mẹ đều đưa về trang học của bé, kể cả khi gõ địa chỉ trực tiếp.</li>
            <li>Muốn quay lại, bấm <b>Ba mẹ</b> ở góc trên và nhập PIN (hoặc mật khẩu nếu chưa đặt PIN).</li>
            <li>Sai 5 lần liên tiếp thì khóa 5 phút.</li>
            <li>PIN được lưu dạng băm trên máy chủ, không lưu trong trình duyệt.</li>
        </ul>
    </div>
</div>

@if (Model.Children.Count > 0)
{
    <div class="sl-card" id="child-pins" style="margin-top:16px">
        <div class="card-t">PIN riêng của từng bé</div>
        <p class="muted" style="margin:4px 0 0;font-size:13px">Không bắt buộc. Bé có PIN phải nhập đúng PIN khi chọn hồ sơ ở màn hình "Hôm nay ai học nào?", nên anh chị em không vào nhầm hồ sơ của nhau. Sai 5 lần thì hồ sơ của bé khóa 5 phút.</p>
        @foreach (var child in Model.Children)
        {
            <div class="sl-row" style="gap:12px;flex-wrap:wrap;padding:14px 0;border-top:1px solid var(--line);margin-top:12px;align-items:flex-end">
                <div style="flex:1 1 180px;min-width:0">
                    <div class="b">@child.Name</div>
                    <div class="muted" style="font-size:12.5px">@(child.HasPin ? $"Có PIN · đặt lúc {child.ChangedAt?.ToLocalTime():dd/MM/yyyy HH:mm}" : "Chưa có PIN: bé vào học không cần PIN")@(child.LockedMinutes is { } minutes ? $" · đang khóa {minutes} phút vì nhập sai nhiều lần" : "")</div>
                </div>
                <form method="post" asp-action="SaveChild" asp-route-id="@child.Id" class="sl-row" style="gap:8px;flex-wrap:wrap;align-items:flex-end">
                    <div class="field" style="width:110px"><label class="lab" for="cp-@child.Id">PIN mới</label><input class="inp" id="cp-@child.Id" name="pin" type="password" inputmode="numeric" pattern="\d{4}" maxlength="4" autocomplete="new-password" required /></div>
                    <div class="field" style="width:110px"><label class="lab" for="cpc-@child.Id">Nhập lại</label><input class="inp" id="cpc-@child.Id" name="confirmPin" type="password" inputmode="numeric" pattern="\d{4}" maxlength="4" autocomplete="new-password" required /></div>
                    <button class="sl-btn sl-btn-p" type="submit"><i class="ic ic-key"></i>@(child.HasPin ? "Đổi PIN" : "Đặt PIN")</button>
                </form>
                @if (child.HasPin)
                {
                    <form method="post" asp-action="RemoveChild" asp-route-id="@child.Id" data-confirm="Bỏ mã PIN của @child.Name?" data-text="Bé sẽ vào học không cần nhập PIN." data-ok-label="Bỏ PIN">
                        <button class="sl-btn" type="submit">Bỏ PIN</button>
                    </form>
                }
            </div>
        }
    </div>
}
