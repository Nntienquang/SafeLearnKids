@model FamilySourcesViewModel
@{
    ViewData["Title"] = """Nguồn nội dung""";
    ViewData["Page"] = "sources-sql";
    ViewData["Nav"] = "sources";
    ViewData["Crumb"] = Html.Raw("""Phụ huynh · Nội dung""");
    ViewData["Heading"] = """Nguồn nội dung""";
    ViewData["Sub"] = """Chặn hoặc cho phép từng nguồn đã duyệt cho gia đình, và đề xuất nguồn mới (US-21).""";
}
@if (TempData["Info"] is string info)
{
    <div class="banner t-g" role="status" style="margin-bottom:16px">@info</div>
}
@if (TempData["Error"] is string error)
{
    <div class="banner t-r" role="alert" style="margin-bottom:16px">@error</div>
}
<div class="sl-card" style="padding:6px 0;overflow-x:auto;margin-bottom:16px">
    <table class="tbl">
        <thead><tr><th>Nguồn đã duyệt</th><th>Loại</th><th>Video</th><th>Gia đình</th><th></th></tr></thead>
        <tbody>
            @foreach (var source in Model.Sources)
            {
                <tr>
                    <td><div class="b">@source.Name</div><div class="muted" style="font-size:12.5px;overflow-wrap:anywhere"><a href="@source.Url" target="_blank" rel="noopener noreferrer">@source.Url</a></div></td>
                    <td>@SourceStatus.PlatformLabel(source.Platform)</td>
                    <td class="b">@source.Videos</td>
                    <td><span class="chip @(source.Blocked ? "t-r" : "t-g")">@(source.Blocked ? "Đang chặn" : "Cho phép")</span></td>
                    <td style="text-align:right">
                        <form asp-action="@(source.Blocked ? "Allow" : "Block")" asp-route-id="@source.Id" method="post">
                            <button class="sl-btn sl-btn-sm @(source.Blocked ? "" : "sl-btn-d")" type="submit">@(source.Blocked ? "Cho phép lại" : "Chặn cho gia đình")</button>
                        </form>
                    </td>
                </tr>
            }
            @if (Model.Sources.Count == 0)
            {
                <tr><td colspan="5"><div class="empty">Chưa có nguồn nào được duyệt</div></td></tr>
            }
        </tbody>
    </table>
</div>
<div style="display:flex;flex-wrap:wrap;gap:16px;align-items:flex-start">
    <form asp-action="Suggest" method="post" class="sl-card" style="flex:1 1 380px;min-width:0;display:flex;flex-direction:column;gap:12px">
        <div class="card-t">Đề xuất nguồn mới</div>
        <div class="field">
            <label asp-for="Suggest.Url" class="lab">Liên kết kênh hoặc danh sách phát</label>
            <input asp-for="Suggest.Url" class="inp" autocomplete="off" maxlength="300" placeholder="https://www.youtube.com/playlist?list=..." />
            <span asp-validation-for="Suggest.Url" class="err"></span>
        </div>
        <div class="field">
            <label asp-for="Suggest.Name" class="lab">Tên nguồn</label>
            <input asp-for="Suggest.Name" class="inp" autocomplete="off" maxlength="150" />
            <span asp-validation-for="Suggest.Name" class="err"></span>
        </div>
        <div class="field">
            <label asp-for="Suggest.Description" class="lab">Vì sao phù hợp với bé (không bắt buộc)</label>
            <textarea asp-for="Suggest.Description" class="inp ta" rows="2" maxlength="500"></textarea>
            <span asp-validation-for="Suggest.Description" class="err"></span>
        </div>
        <div class="banner t-b" style="font-size:13px;font-weight:600"><i class="ic ic-info"></i>Hệ thống chỉ lưu thông tin video, không tải video về. Nguồn chỉ đến với bé sau khi quản trị viên duyệt.</div>
        <div class="sl-row" style="justify-content:flex-end"><button class="sl-btn sl-btn-p" type="submit"><i class="ic ic-send"></i>Gửi đề xuất</button></div>
    </form>
    <div class="sl-card" style="flex:1 1 320px;min-width:0">
        <div class="card-t">Đề xuất của bạn</div>
        @foreach (var suggestion in Model.Suggestions)
        {
            <div class="sl-row" style="gap:12px;padding:12px 0;border-top:1px solid var(--line);margin-top:10px">
                <div class="grow" style="min-width:0"><div class="b">@suggestion.Name</div><div class="muted" style="font-size:12.5px">@SourceStatus.PlatformLabel(suggestion.Platform) · @suggestion.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")@(suggestion.ReviewNote is null ? "" : " · " + suggestion.ReviewNote)</div></div>
                <span class="chip @SourceStatus.Tone(suggestion.Status)">@SourceStatus.Label(suggestion.Status)</span>
            </div>
        }
        @if (Model.Suggestions.Count == 0)
        {
            <div class="empty" style="margin-top:12px">Bạn chưa đề xuất nguồn nào</div>
        }
    </div>
</div>
