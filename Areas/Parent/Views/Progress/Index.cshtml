@{
    ViewData["Title"] = """Tiến độ và lộ trình""";
    ViewData["Page"] = "progress";
    ViewData["Nav"] = "progress";
    ViewData["Crumb"] = Html.Raw("""Phụ huynh · Giám sát""");
    ViewData["Heading"] = """Tiến độ và lộ trình""";
    ViewData["Sub"] = """Theo dõi từng môn và lộ trình học của Minh An (US-26, 27).""";
}
@section Actions {
<div class="seg"><span class="on">Minh An</span><span>Bảo Nam</span></div>
}
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:16px">
<div class="sl-card kpi"><div class="sl-row" style="justify-content:space-between"><span class="muted b" style="font-size:13px">Bài hoàn thành</span><span class="ib t-p" style="width:38px;height:38px"><i class="ic ic-book"></i></span></div><div class="kpi-v">24 / 60</div><div class="bar"><i style="width:40%"></i></div><div class="kpi-d up">40% chương trình lớp 3</div></div><div class="sl-card kpi"><div class="sl-row" style="justify-content:space-between"><span class="muted b" style="font-size:13px">Điểm quiz trung bình</span><span class="ib t-a" style="width:38px;height:38px"><i class="ic ic-target"></i></span></div><div class="kpi-v">8,4</div><div class="kpi-d up">Cao nhất: Tiếng Việt 9,1</div></div><div class="sl-card kpi"><div class="sl-row" style="justify-content:space-between"><span class="muted b" style="font-size:13px">Chuỗi ngày học</span><span class="ib t-r" style="width:38px;height:38px"><i class="ic ic-flame"></i></span></div><div class="kpi-v">6 ngày</div><div class="kpi-d up">Kỷ lục: 11 ngày</div></div><div class="sl-card kpi"><div class="sl-row" style="justify-content:space-between"><span class="muted b" style="font-size:13px">Huy hiệu</span><span class="ib t-v" style="width:38px;height:38px"><i class="ic ic-trophy"></i></span></div><div class="kpi-v">9 / 24</div><div class="kpi-d up">Mới: Siêu chăm chỉ</div></div></div>
<div class="sl-card" style="margin-top:16px"><div class="card-h"><div><div class="card-t">Lộ trình Toán · Lớp 3</div><div class="card-s">Mở bài tiếp theo khi hoàn thành bài trước.</div></div><span class="chip t-p">Bước 4 / 7</span></div>
<div style="display:flex;flex-wrap:nowrap;align-items:flex-start;overflow:hidden;padding-top:8px"><div class="sl-col" style="align-items:center;gap:8px;width:120px"><span class="av" style="width:56px;height:56px;background:var(--green);color:#fff;box-shadow:none"><i class="ic ic-check"></i></span><span class="b" style="font-size:13px;text-align:center">Số đến 1000</span></div><i style="flex:1;height:4px;border-radius:2px;background:var(--line);margin-top:26px;min-width:20px"></i><div class="sl-col" style="align-items:center;gap:8px;width:120px"><span class="av" style="width:56px;height:56px;background:var(--green);color:#fff;box-shadow:none"><i class="ic ic-check"></i></span><span class="b" style="font-size:13px;text-align:center">Cộng trừ</span></div><i style="flex:1;height:4px;border-radius:2px;background:var(--line);margin-top:26px;min-width:20px"></i><div class="sl-col" style="align-items:center;gap:8px;width:120px"><span class="av" style="width:56px;height:56px;background:var(--green);color:#fff;box-shadow:none"><i class="ic ic-check"></i></span><span class="b" style="font-size:13px;text-align:center">Bảng nhân 2</span></div><i style="flex:1;height:4px;border-radius:2px;background:var(--line);margin-top:26px;min-width:20px"></i><div class="sl-col" style="align-items:center;gap:8px;width:120px"><span class="av" style="width:56px;height:56px;background:var(--primary);color:#fff;box-shadow:0 0 0 6px var(--primary-soft)"><i class="ic ic-play"></i></span><span class="b" style="font-size:13px;text-align:center">Bảng nhân 5</span></div><i style="flex:1;height:4px;border-radius:2px;background:var(--line);margin-top:26px;min-width:20px"></i><div class="sl-col" style="align-items:center;gap:8px;width:120px"><span class="av" style="width:56px;height:56px;background:var(--surface-2);color:var(--text-3);box-shadow:none"><i class="ic ic-lock"></i></span><span class="b" style="font-size:13px;text-align:center">Phân số</span></div><i style="flex:1;height:4px;border-radius:2px;background:var(--line);margin-top:26px;min-width:20px"></i><div class="sl-col" style="align-items:center;gap:8px;width:120px"><span class="av" style="width:56px;height:56px;background:var(--surface-2);color:var(--text-3);box-shadow:none"><i class="ic ic-lock"></i></span><span class="b" style="font-size:13px;text-align:center">Hình học</span></div></div></div>
<div style="display:flex;flex-wrap:wrap;gap:16px;margin-top:16px">
<div class="sl-card" style="flex:1 1 360px;min-width:0"><div class="card-t" style="margin-bottom:12px">Điểm quiz theo tuần</div><div style="display:flex;align-items:flex-end;gap:16px;height:150px"><div class="sl-col" style="flex:1;align-items:center;gap:6px;justify-content:flex-end;height:100%"><span class="b" style="font-size:12px">6.5</span><i style="width:100%;max-width:48px;height:84px;border-radius:10px 10px 4px 4px;background:var(--primary-soft)"></i></div><div class="sl-col" style="flex:1;align-items:center;gap:6px;justify-content:flex-end;height:100%"><span class="b" style="font-size:12px">7.0</span><i style="width:100%;max-width:48px;height:91px;border-radius:10px 10px 4px 4px;background:var(--primary-soft)"></i></div><div class="sl-col" style="flex:1;align-items:center;gap:6px;justify-content:flex-end;height:100%"><span class="b" style="font-size:12px">7.5</span><i style="width:100%;max-width:48px;height:97px;border-radius:10px 10px 4px 4px;background:var(--primary-soft)"></i></div><div class="sl-col" style="flex:1;align-items:center;gap:6px;justify-content:flex-end;height:100%"><span class="b" style="font-size:12px">8.0</span><i style="width:100%;max-width:48px;height:104px;border-radius:10px 10px 4px 4px;background:var(--primary-soft)"></i></div><div class="sl-col" style="flex:1;align-items:center;gap:6px;justify-content:flex-end;height:100%"><span class="b" style="font-size:12px">7.8</span><i style="width:100%;max-width:48px;height:101px;border-radius:10px 10px 4px 4px;background:var(--primary-soft)"></i></div><div class="sl-col" style="flex:1;align-items:center;gap:6px;justify-content:flex-end;height:100%"><span class="b" style="font-size:12px">8.4</span><i style="width:100%;max-width:48px;height:109px;border-radius:10px 10px 4px 4px;background:var(--grad)"></i></div></div></div>
<div class="sl-card" style="flex:1 1 360px;min-width:0"><div class="card-t" style="margin-bottom:6px">Cần chú ý</div>
<div class="sl-row" style="gap:14px;padding:14px 0;border-top:1px solid var(--line)"><span class="ib t-r"><i class="ic ic-alert"></i></span><div class="grow"><div class="b">Phân số cơ bản</div><div class="muted" style="font-size:13px">Điểm 5/10 · nên học lại</div></div><a class="sl-btn sl-btn-sm" href="~/library">Giao lại</a></div><div class="sl-row" style="gap:14px;padding:14px 0;border-top:1px solid var(--line)"><span class="ib t-a"><i class="ic ic-info"></i></span><div class="grow"><div class="b">Tiếng Anh chưa bắt đầu</div><div class="muted" style="font-size:13px">0 / 12 bài</div></div><a class="sl-btn sl-btn-sm" href="~/library">Chọn bài</a></div></div></div>
