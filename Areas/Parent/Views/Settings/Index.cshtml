@{
    ViewData["Title"] = "Cài đặt tài khoản";
    ViewData["Page"] = "settings";
    ViewData["Nav"] = "settings";
    ViewData["Crumb"] = Html.Raw("Phụ huynh · Tài khoản");
    ViewData["Heading"] = "Cài đặt";
    ViewData["Sub"] = "Hồ sơ phụ huynh, giao diện và bảo mật đăng nhập.";

    var fullName = User.FindFirst("FullName")?.Value;
    if (string.IsNullOrWhiteSpace(fullName))
    {
        fullName = User.Identity?.Name ?? "Phụ huynh";
    }
    var avatarUrl = User.FindFirst("AvatarUrl")?.Value;
}
@section Actions {
<button class="sl-btn sl-btn-p" type="button" disabled title="Chỉnh sửa hồ sơ chưa khả dụng.">Lưu thay đổi</button>
}
@if (TempData["Info"] is string info)
{
    <div class="banner t-g" role="status" style="margin-bottom:16px">@info</div>
}
@if (TempData["Error"] is string error)
{
    <div class="banner t-r" role="alert" style="margin-bottom:16px">@error</div>
}
<div style="display:flex;flex-wrap:wrap;gap:16px;align-items:flex-start">
<div class="sl-card" style="flex:2 1 460px;min-width:0;display:flex;flex-direction:column;gap:16px"><div class="card-t">Hồ sơ</div>
<form asp-action="Avatar" method="post" enctype="multipart/form-data" style="display:flex;flex-direction:column;gap:12px">
    <partial name="_AvatarPicker" model="@(new AvatarViewModel(avatarUrl, fullName, "", "var(--grad)"))" />
    <button class="sl-btn sl-btn-sm sl-btn-p" type="submit" style="align-self:flex-start" hidden data-avatar-save>Lưu ảnh</button>
</form>
<div class="field"><label class="lab" for="st1">Họ và tên</label><input id="st1" class="inp" value="@User.FindFirst("FullName")?.Value" readonly></div><div class="field"><label class="lab" for="st2">Email</label><input id="st2" class="inp" value="@User.Identity?.Name" readonly></div>
<div class="field"><span class="lab">Đổi mật khẩu</span><a class="sl-btn" href="~/change-password" style="align-self:flex-start"><i class="ic ic-key"></i>Đổi mật khẩu</a></div></div>
<div class="sl-col" style="flex:1 1 320px;min-width:0;gap:16px"><div class="sl-card"><div class="card-t" style="margin-bottom:12px">Giao diện</div><div style="display:grid;grid-template-columns:repeat(3,1fr);gap:10px">
<div class="sl-col" style="gap:8px;align-items:center;padding:12px;border-radius:16px;border:2px solid var(--primary)"><span class="ib t-a"><i class="ic ic-sun"></i></span><span class="b" style="font-size:13px">Sáng</span></div><div class="sl-col" style="gap:8px;align-items:center;padding:12px;border-radius:16px;border:2px solid var(--line)"><span class="ib t-v"><i class="ic ic-moon"></i></span><span class="b" style="font-size:13px">Tối</span></div><div class="sl-col" style="gap:8px;align-items:center;padding:12px;border-radius:16px;border:2px solid var(--line)"><span class="ib t-n"><i class="ic ic-monitor"></i></span><span class="b" style="font-size:13px">Theo máy</span></div></div></div>
<div class="sl-card"><div class="card-t" style="margin-bottom:12px">Thông báo</div><div class="sl-row" style="justify-content:space-between;padding:9px 0"><span class="b" style="font-size:14px">Xin thêm giờ</span><span class="switch on"></span></div><div class="sl-row" style="justify-content:space-between;padding:9px 0"><span class="b" style="font-size:14px">Báo cáo tuần</span><span class="switch on"></span></div><div class="sl-row" style="justify-content:space-between;padding:9px 0"><span class="b" style="font-size:14px">Huy hiệu mới</span><span class="switch"></span></div></div></div></div>
