@{
    ViewData["Title"] = """Tổng quan phụ huynh""";
    ViewData["Page"] = "parent-home";
    ViewData["Nav"] = "home";
    ViewData["Crumb"] = Html.Raw("""Trang chủ""");
    ViewData["Heading"] = """Chào chị Hà, hôm nay Minh An học thế nào?""";
    ViewData["Sub"] = """Tóm tắt học tập, thời gian và việc cần xử lý.""";
}
@section Actions {
<a class="sl-btn" href="~/weekly"><i class="ic ic-download"></i>Báo cáo tuần</a><a class="sl-btn sl-btn-p" href="~/library"><i class="ic ic-plus"></i>Giao bài mới</a>
}
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:16px">
<div class="sl-card kpi"><div class="sl-row" style="justify-content:space-between"><span class="muted b" style="font-size:13px">Hôm nay · Minh An</span><span class="ib t-p" style="width:38px;height:38px"><i class="ic ic-clock"></i></span></div><div class="kpi-v">32 phút</div><div class="bar"><i style="width:53%"></i></div><div class="kpi-d up">Còn 28 / 60 phút</div></div>
<div class="sl-card kpi"><div class="sl-row" style="justify-content:space-between"><span class="muted b" style="font-size:13px">Bài đã hoàn thành tuần này</span><span class="ib t-g" style="width:38px;height:38px"><i class="ic ic-book"></i></span></div><div class="kpi-v">7 / 10</div><div class="bar"><i style="width:70%"></i></div><div class="kpi-d up">+2 so với tuần trước</div></div>
<div class="sl-card kpi"><div class="sl-row" style="justify-content:space-between"><span class="muted b" style="font-size:13px">Điểm quiz trung bình</span><span class="ib t-a" style="width:38px;height:38px"><i class="ic ic-target"></i></span></div><div class="kpi-v">8,4</div><div class="kpi-d up">+0,6 so với tuần trước</div></div>
<div class="sl-card kpi"><div class="sl-row" style="justify-content:space-between"><span class="muted b" style="font-size:13px">Báo cáo chờ xử lý</span><span class="ib t-r" style="width:38px;height:38px"><i class="ic ic-flag"></i></span></div><div class="kpi-v">1</div><div class="kpi-d down">Gửi bởi Minh An hôm qua</div></div>
</div>
<div style="display:flex;flex-wrap:wrap;gap:16px;margin-top:16px">
<div class="sl-card" style="flex:2 1 520px;min-width:0"><div class="card-h"><div><div class="card-t">Thời gian học 7 ngày qua</div><div class="card-s">Giới hạn mỗi ngày: 60 phút</div></div><div class="seg"><span class="on">Tuần</span><span>Tháng</span></div></div>
<div style="display:flex;align-items:flex-end;gap:14px;height:180px;margin-top:18px;border-bottom:1px dashed var(--line);padding-bottom:0">
<div class="sl-col" style="flex:1;align-items:center;gap:8px;height:100%;justify-content:flex-end"><span class="muted" style="font-size:12px;font-weight:700">35</span><i style="width:100%;max-width:46px;height:91px;border-radius:12px 12px 4px 4px;background:var(--primary-soft)"></i></div><div class="sl-col" style="flex:1;align-items:center;gap:8px;height:100%;justify-content:flex-end"><span class="muted" style="font-size:12px;font-weight:700">48</span><i style="width:100%;max-width:46px;height:124px;border-radius:12px 12px 4px 4px;background:var(--primary-soft)"></i></div><div class="sl-col" style="flex:1;align-items:center;gap:8px;height:100%;justify-content:flex-end"><span class="muted" style="font-size:12px;font-weight:700">60</span><i style="width:100%;max-width:46px;height:156px;border-radius:12px 12px 4px 4px;background:var(--primary-soft)"></i></div><div class="sl-col" style="flex:1;align-items:center;gap:8px;height:100%;justify-content:flex-end"><span class="muted" style="font-size:12px;font-weight:700">42</span><i style="width:100%;max-width:46px;height:109px;border-radius:12px 12px 4px 4px;background:var(--primary-soft)"></i></div><div class="sl-col" style="flex:1;align-items:center;gap:8px;height:100%;justify-content:flex-end"><span class="muted" style="font-size:12px;font-weight:700">55</span><i style="width:100%;max-width:46px;height:143px;border-radius:12px 12px 4px 4px;background:var(--primary-soft)"></i></div><div class="sl-col" style="flex:1;align-items:center;gap:8px;height:100%;justify-content:flex-end"><span class="muted" style="font-size:12px;font-weight:700">20</span><i style="width:100%;max-width:46px;height:52px;border-radius:12px 12px 4px 4px;background:var(--primary-soft)"></i></div><div class="sl-col" style="flex:1;align-items:center;gap:8px;height:100%;justify-content:flex-end"><span class="muted" style="font-size:12px;font-weight:700">32</span><i style="width:100%;max-width:46px;height:83px;border-radius:12px 12px 4px 4px;background:var(--grad)"></i></div></div>
<div class="sl-row" style="gap:14px;margin-top:8px;color:var(--text-3);font-size:12.5px;font-weight:700"><span style="flex:1;text-align:center">T2</span><span style="flex:1;text-align:center">T3</span><span style="flex:1;text-align:center">T4</span><span style="flex:1;text-align:center">T5</span><span style="flex:1;text-align:center">T6</span><span style="flex:1;text-align:center">T7</span><span style="flex:1;text-align:center">CN</span></div></div>
<div class="sl-card" style="flex:1 1 300px;min-width:0"><div class="card-h"><div class="card-t">Cần ba mẹ xem</div><a class="chip t-n" href="~/notifications">Tất cả</a></div>
<div class="sl-row" style="gap:14px;padding:14px 0;border-top:1px solid var(--line)"><span class="ib t-a"><i class="ic ic-clock"></i></span><div class="grow"><div class="b">Xin thêm giờ học</div><div class="muted" style="font-size:13px">Minh An xin thêm 15 phút lúc 19:40</div></div><a class="sl-btn sl-btn-sm sl-btn-p" href="~/time">Duyệt</a></div>
<div class="sl-row" style="gap:14px;padding:14px 0;border-top:1px solid var(--line)"><span class="ib t-r"><i class="ic ic-alert"></i></span><div class="grow"><div class="b">Bài quiz điểm thấp</div><div class="muted" style="font-size:13px">Phân số cơ bản · 5/10 điểm</div></div><a class="sl-btn sl-btn-sm" href="~/progress">Xem</a></div>
<div class="sl-row" style="gap:14px;padding:14px 0;border-top:1px solid var(--line)"><span class="ib t-v"><i class="ic ic-file"></i></span><div class="grow"><div class="b">Báo cáo tuần sẵn sàng</div><div class="muted" style="font-size:13px">Tuần 12–18/10 đã tạo xong</div></div><a class="sl-btn sl-btn-sm" href="~/weekly">Mở</a></div></div></div>
<div style="display:flex;flex-wrap:wrap;gap:16px;margin-top:16px">
<div class="sl-card" style="flex:1 1 380px;min-width:0"><div class="card-h"><div class="card-t">Đang học dở</div><a class="sl-btn sl-btn-sm sl-btn-g" href="~/progress">Lộ trình<i class="ic ic-arrowr"></i></a></div>
<div class="sl-row" style="gap:16px;padding-top:6px"><div style="width:120px;height:80px;border-radius:16px;background:linear-gradient(135deg,#6A4CFF,#38BDF8);display:flex;align-items:center;justify-content:center;color:#fff"><i class="ic ic-play ic-lg"></i></div><div class="grow sl-col" style="gap:6px"><span class="chip t-b" style="align-self:flex-start">Toán · Lớp 3</span><div class="b">Bảng nhân 5</div><div class="bar bar-l"><i style="width:62%"></i></div><span class="muted" style="font-size:12.5px">62% · đã xem 6/10 phút</span></div></div></div>
<div class="sl-card" style="flex:1 1 380px;min-width:0"><div class="card-h"><div class="card-t">Tiến độ theo môn</div></div>
<div class="sl-row" style="gap:12px;padding:8px 0"><span style="width:96px;font-weight:700;font-size:14px">Toán</span><div class="bar grow"><i style="width:72%;background:var(--primary)"></i></div><span class="b" style="width:40px;text-align:right">72%</span></div><div class="sl-row" style="gap:12px;padding:8px 0"><span style="width:96px;font-weight:700;font-size:14px">Tiếng Việt</span><div class="bar grow"><i style="width:58%;background:var(--teal)"></i></div><span class="b" style="width:40px;text-align:right">58%</span></div><div class="sl-row" style="gap:12px;padding:8px 0"><span style="width:96px;font-weight:700;font-size:14px">Khoa học</span><div class="bar grow"><i style="width:40%;background:var(--sun)"></i></div><span class="b" style="width:40px;text-align:right">40%</span></div><div class="sl-row" style="gap:12px;padding:8px 0"><span style="width:96px;font-weight:700;font-size:14px">Tiếng Anh</span><div class="bar grow"><i style="width:25%;background:var(--rose)"></i></div><span class="b" style="width:40px;text-align:right">25%</span></div></div></div>
