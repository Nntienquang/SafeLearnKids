@{
    ViewData["Title"] = """Báo cáo tuần""";
    ViewData["Page"] = "weekly";
    ViewData["Nav"] = "weekly";
    ViewData["Crumb"] = Html.Raw("""Phụ huynh · Giám sát""");
    ViewData["Heading"] = """Báo cáo tuần""";
    ViewData["Sub"] = """Tuần 12 – 18/10/2026 · gửi mỗi Chủ nhật 19:00 (US-29).""";
}
@section Actions {
<button class="sl-btn" type="button"><i class="ic ic-mail"></i>Gửi lại email</button><button class="sl-btn sl-btn-p" type="button"><i class="ic ic-download"></i>Tải PDF</button>
}
<div style="display:flex;flex-wrap:wrap;gap:16px;align-items:flex-start">
<div class="sl-card" style="flex:2 1 560px;min-width:0;display:flex;flex-direction:column;gap:20px">
<div style="border-radius:20px;background:var(--grad);color:#fff;padding:24px;display:flex;flex-wrap:wrap;gap:24px;align-items:center"><div class="grow"><div style="opacity:.85;font-size:13px;font-weight:700">Minh An · Lớp 3</div><div style="font-size:28px;font-weight:800;letter-spacing:-.02em;margin-top:4px">Một tuần học đều đặn</div></div><div class="sl-row" style="gap:22px"><div><div style="font-size:30px;font-weight:800">4 giờ 12</div><div style="opacity:.85;font-size:12.5px">thời gian học</div></div><div><div style="font-size:30px;font-weight:800">7</div><div style="opacity:.85;font-size:12.5px">bài hoàn thành</div></div><div><div style="font-size:30px;font-weight:800">8,4</div><div style="opacity:.85;font-size:12.5px">điểm quiz TB</div></div></div></div>
<div><div class="card-t" style="margin-bottom:10px">Thời gian theo môn</div><div class="sl-row" style="gap:12px;padding:6px 0"><span style="width:100px;font-weight:700;font-size:14px">Toán</span><div class="bar grow"><i style="width:80%;background:var(--primary)"></i></div><span class="b" style="width:64px;text-align:right">1g 40</span></div><div class="sl-row" style="gap:12px;padding:6px 0"><span style="width:100px;font-weight:700;font-size:14px">Tiếng Việt</span><div class="bar grow"><i style="width:55%;background:var(--teal)"></i></div><span class="b" style="width:64px;text-align:right">1g 10</span></div><div class="sl-row" style="gap:12px;padding:6px 0"><span style="width:100px;font-weight:700;font-size:14px">Khoa học</span><div class="bar grow"><i style="width:35%;background:var(--sun)"></i></div><span class="b" style="width:64px;text-align:right">0g 50</span></div><div class="sl-row" style="gap:12px;padding:6px 0"><span style="width:100px;font-weight:700;font-size:14px">Tiếng Anh</span><div class="bar grow"><i style="width:15%;background:var(--rose)"></i></div><span class="b" style="width:64px;text-align:right">0g 32</span></div></div>
<div class="banner t-g" style="font-weight:600;font-size:14px"><i class="ic ic-sparkles"></i>Điểm sáng: quiz Toán tăng từ 7,0 lên 8,4. Gợi ý: ôn lại Phân số cơ bản (5/10).</div></div>
<div class="sl-card" style="flex:1 1 300px;min-width:0"><div class="card-t" style="margin-bottom:12px">Gửi báo cáo tự động</div>
<div class="sl-row" style="justify-content:space-between;padding:10px 0"><span class="b">Gửi qua email</span><span class="switch on"></span></div><div class="sl-row" style="justify-content:space-between;padding:10px 0;border-top:1px solid var(--line)"><span class="b">Thông báo trong ứng dụng</span><span class="switch on"></span></div>
<div class="field" style="margin-top:12px"><span class="lab">Ngày gửi</span><div class="seg"><span>T2</span><span>T7</span><span class="on">CN</span></div></div>
<div class="card-s" style="margin-top:14px">Các tuần trước</div><div class="sl-col" style="gap:8px;margin-top:8px"><div class="sl-row" style="padding:10px 12px;border-radius:12px;background:var(--surface-2);justify-content:space-between"><span class="b" style="font-size:13.5px">5 – 11/10/2026</span><i class="ic ic-download"></i></div><div class="sl-row" style="padding:10px 12px;border-radius:12px;background:var(--surface-2);justify-content:space-between"><span class="b" style="font-size:13.5px">28/9 – 4/10/2026</span><i class="ic ic-download"></i></div><div class="sl-row" style="padding:10px 12px;border-radius:12px;background:var(--surface-2);justify-content:space-between"><span class="b" style="font-size:13.5px">21 – 27/9/2026</span><i class="ic ic-download"></i></div></div></div></div>
