@model WeeklyViewModel
@{
    var end = Model.WeekStart.AddDays(6);
    ViewData["Title"] = """Báo cáo tuần""";
    ViewData["Page"] = "weekly-sql";
    ViewData["Nav"] = "weekly";
    ViewData["Crumb"] = Html.Raw("""Phụ huynh · Giám sát""");
    ViewData["Heading"] = """Báo cáo tuần""";
    ViewData["Sub"] = $"{Model.Child.Name} · tuần {Model.WeekStart:dd/MM} – {end:dd/MM/yyyy}" + (Model.CurrentWeek ? " (tuần này, đang cập nhật)" : "") + " (US-47).";
    var maxMinutes = Math.Max(1, Model.Days.Max(day => day.Minutes));
    string[] dayNames = ["T2", "T3", "T4", "T5", "T6", "T7", "CN"];
}
@section Actions {
<div class="sl-row" style="gap:8px;flex-wrap:wrap" data-noprint>
    <a class="sl-btn" asp-action="Export" asp-route-child="@Model.Child.Id"><i class="ic ic-download"></i>Tải CSV các tuần</a>
    <button class="sl-btn sl-btn-p" type="button" data-print><i class="ic ic-file"></i>In / lưu PDF</button>
</div>
}
<form method="get" asp-action="Index" class="sl-row" style="gap:8px;flex-wrap:wrap;margin-bottom:16px" data-noprint>
    @if (Model.Children.Count > 1)
    {
        <label class="sr-only" for="weekly-child">Bé</label>
        <select class="inp" id="weekly-child" name="child" style="width:auto">
            @foreach (var child in Model.Children)
            {
                <option value="@child.Id" selected="@(child.Id == Model.Child.Id)">@child.Name</option>
            }
        </select>
    }
    else
    {
        <input type="hidden" name="child" value="@Model.Child.Id" />
    }
    <label class="sr-only" for="weekly-week">Tuần</label>
    <select class="inp" id="weekly-week" name="week" style="width:auto">
        @foreach (var week in Model.Weeks)
        {
            <option value="@week.ToString("yyyy-MM-dd")" selected="@(week == Model.WeekStart)">@week.ToString("dd/MM") – @week.AddDays(6).ToString("dd/MM/yyyy")@(week == Model.Weeks[0] ? " (tuần này)" : "")</option>
        }
    </select>
    <button class="sl-btn" type="submit">Xem</button>
</form>
<div style="display:flex;flex-wrap:wrap;gap:16px;align-items:flex-start">
    <div class="sl-card" style="flex:2 1 560px;min-width:0;display:flex;flex-direction:column;gap:20px">
        <div style="border-radius:20px;background:var(--grad);color:#fff;padding:24px;display:flex;flex-wrap:wrap;gap:24px;align-items:center">
            <div class="grow" style="min-width:220px">
                <div style="opacity:.85;font-size:13px;font-weight:700">@Model.Child.Name · Lớp @Model.Child.Grade</div>
                <div style="font-size:18px;font-weight:800;line-height:1.5;margin-top:6px">@Model.Summary</div>
            </div>
            <div class="sl-row" style="gap:22px">
                <div><div style="font-size:30px;font-weight:800">@Model.TotalMinutes</div><div style="opacity:.85;font-size:12.5px">phút học@(Model.PreviousMinutes is { } before ? $" (tuần trước {before})" : "")</div></div>
                <div><div style="font-size:30px;font-weight:800">@Model.LessonsCompleted</div><div style="opacity:.85;font-size:12.5px">bài hoàn thành</div></div>
                <div><div style="font-size:30px;font-weight:800">@(Model.AvgQuizPercent is { } avg ? avg.ToString("0.#") + "%" : "–")</div><div style="opacity:.85;font-size:12.5px">@Model.QuizAttempts lượt bài tập</div></div>
            </div>
        </div>
        <div>
            <div class="card-t" style="margin-bottom:10px">Số phút mỗi ngày</div>
            <div style="display:flex;align-items:flex-end;gap:10px;height:150px" role="img" aria-label="Số phút học: @string.Join(", ", Model.Days.Select((day, i) => $"{dayNames[i]} {day.Minutes} phút"))">
                @for (var i = 0; i < Model.Days.Count; i++)
                {
                    var (day, minutes) = Model.Days[i];
                    <div class="sl-col" style="flex:1;align-items:center;gap:6px;justify-content:flex-end;height:100%">
                        <span class="b" style="font-size:12px">@minutes</span>
                        <i style="width:100%;max-width:44px;height:@(Math.Max(4, minutes * 110 / maxMinutes))px;border-radius:10px 10px 4px 4px;background:@(minutes > 0 ? "var(--grad)" : "var(--surface-2)")"></i>
                        <span class="muted" style="font-size:12px">@dayNames[i] @day.ToString("dd")</span>
                    </div>
                }
            </div>
        </div>
        <div>
            <div class="card-t" style="margin-bottom:10px">Theo môn</div>
            @foreach (var row in Model.Subjects)
            {
                <div class="sl-row" style="gap:12px;padding:8px 0;border-top:1px solid var(--line);flex-wrap:wrap">
                    <span style="width:12px;height:12px;border-radius:6px;background:linear-gradient(135deg,@row.C[0],@row.C[1])" aria-hidden="true"></span>
                    <span class="b grow">@row.Name</span>
                    <span>@row.Lessons bài</span>
                    <span class="muted">@row.Attempts lượt bài tập@(row.AvgQuiz is { } score ? $" · {score:0.#}%" : "")</span>
                </div>
            }
            @if (Model.Subjects.Count == 0)
            {
                <p class="muted" style="margin:0">Tuần này chưa có bài học hay bài tập nào.</p>
            }
        </div>
    </div>
    <div class="sl-col" style="flex:1 1 300px;min-width:0;gap:16px">
        <div class="sl-card">
            <div class="card-t" style="margin-bottom:10px">Điểm nổi bật</div>
            <div class="sl-row" style="gap:12px;padding:8px 0"><span class="ib t-g" aria-hidden="true"><i class="ic ic-star"></i></span><div><div class="muted" style="font-size:12.5px">Làm tốt nhất</div><div class="b">@(Model.StrongSubject ?? "Chưa đủ dữ liệu")</div></div></div>
            <div class="sl-row" style="gap:12px;padding:8px 0;border-top:1px solid var(--line)"><span class="ib t-r" aria-hidden="true"><i class="ic ic-alert"></i></span><div><div class="muted" style="font-size:12.5px">Cần ôn thêm</div><div class="b">@(Model.NeedsAttentionSubject ?? "Không có")</div></div></div>
            @if (Model.Badges.Count > 0)
            {
                <div class="sl-row" style="gap:12px;padding:8px 0;border-top:1px solid var(--line)"><span class="ib t-v" aria-hidden="true"><i class="ic ic-trophy"></i></span><div><div class="muted" style="font-size:12.5px">Huy hiệu mới</div><div class="b">@string.Join(", ", Model.Badges)</div></div></div>
            }
        </div>
        @if (Model.Goal is { } goal)
        {
            <div class="sl-card">
                <div class="card-t" style="margin-bottom:10px">Mục tiêu tuần@(goal.Reached ? " · Đã đạt" : "")</div>
                @if (goal.TargetLessons is { } lessons)
                {
                    <div class="sl-row" style="font-size:13.5px"><span class="grow">Bài học</span><span class="b">@goal.Lessons / @lessons</span></div>
                }
                @if (goal.TargetMinutes is { } minutes)
                {
                    <div class="sl-row" style="font-size:13.5px"><span class="grow">Số phút</span><span class="b">@goal.Minutes / @minutes</span></div>
                }
            </div>
        }
        <div class="sl-card">
            <div class="card-t" style="margin-bottom:6px">Gửi báo cáo</div>
            <p class="muted" style="margin:0;font-size:13px">
                @(Model.CurrentWeek ? "Tuần này chưa kết thúc. Báo cáo được tạo vào đầu tuần sau." : $"Báo cáo tạo lúc {Model.GeneratedAt.ToLocalTime():dd/MM HH:mm}" + (Model.EmailedAt is { } sent ? $", đã gửi email lúc {sent.ToLocalTime():dd/MM HH:mm}." : "."))
                Bật hoặc tắt email báo cáo tuần ở <a href="/settings">Cài đặt</a>.
            </p>
        </div>
    </div>
</div>
