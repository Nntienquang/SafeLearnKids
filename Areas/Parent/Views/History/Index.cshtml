@model HistoryViewModel
@{
    ViewData["Title"] = """Lịch sử học""";
    ViewData["Page"] = "history-sql";
    ViewData["Nav"] = "history";
    ViewData["Crumb"] = Html.Raw("""Phụ huynh · Giám sát""");
    ViewData["Heading"] = """Lịch sử học""";
    ViewData["Sub"] = """Bé đã học gì, bao lâu, tìm gì và báo cáo nội dung nào (US-29, US-33).""";
    var maxMinutes = Math.Max(1, Model.Days.Max(day => day.Minutes));
}
@section Actions {
<a class="sl-btn" asp-action="Export" asp-route-child="@Model.Child.Id"><i class="ic ic-download"></i>Xuất CSV</a>
}
@if (Model.Children.Count > 1)
{
    <nav class="sl-row" style="gap:8px;flex-wrap:wrap;margin-bottom:16px" aria-label="Chọn bé">
        @foreach (var child in Model.Children)
        {
            <a class="sl-btn sl-btn-sm @(child.Id == Model.Child.Id ? "sl-btn-p" : "")" asp-action="Index" asp-route-child="@child.Id" aria-current="@(child.Id == Model.Child.Id ? "page" : null)">@child.Name</a>
        }
    </nav>
}
<div style="display:flex;flex-wrap:wrap;gap:16px;align-items:flex-start">
    <div class="sl-col" style="flex:2 1 520px;min-width:0;gap:16px">
        <div class="sl-card" style="padding:6px 0;overflow-x:auto">
            <table class="tbl">
                <thead><tr><th>Bài học</th><th>Lần gần nhất</th><th>Thời gian xem</th><th>Kết quả</th></tr></thead>
                <tbody>
                    @foreach (var row in Model.Lessons)
                    {
                        <tr>
                            <td><div class="b">@row.Title</div><div class="muted" style="font-size:12.5px">@row.Subject</div></td>
                            <td class="muted">@row.UpdatedAt.ToLocalTime().ToString("dd/MM HH:mm")</td>
                            <td class="b">@row.WatchMinutes phút</td>
                            <td><span class="chip @(row.Status == "Completed" ? "t-g" : "t-b")">@(row.Status == "Completed" ? "Hoàn thành" : $"Đang học {row.Percent}%")</span></td>
                        </tr>
                    }
                    @if (Model.Lessons.Count == 0)
                    {
                        <tr><td colspan="4"><div class="empty">@Model.Child.Name chưa học bài nào</div></td></tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="sl-card" id="quizzes">
            <div class="card-t" style="margin-bottom:10px">Bài tập đã làm</div>
            @foreach (var attempt in Model.Attempts)
            {
                <a class="sl-row" style="gap:10px;padding:10px 0;border-top:1px solid var(--line);text-decoration:none;color:inherit;flex-wrap:wrap" asp-action="Result" asp-route-id="@attempt.Id">
                    <div class="grow" style="min-width:180px">
                        <div class="b">@attempt.Quiz</div>
                        <div class="muted" style="font-size:12.5px">@attempt.Lesson · @attempt.SubmittedAt.ToLocalTime().ToString("dd/MM HH:mm") · @attempt.Correct/@attempt.Total câu đúng@(attempt.Assigned ? " · ba mẹ giao" : "")@(attempt.Late ? " · nộp muộn" : "")</div>
                    </div>
                    <span class="chip @(attempt.Passed == true ? "t-g" : "t-a")">@((attempt.Score ?? 0).ToString("0.#"))% · @(attempt.Passed == true ? "Đạt" : "Chưa đạt")</span>
                    <i class="ic ic-chevr" aria-hidden="true"></i>
                </a>
            }
            @if (Model.Attempts.Count == 0)
            {
                <p class="muted" style="margin:0">@Model.Child.Name chưa làm bài tập nào.</p>
            }
        </div>
        <div class="sl-card">
            <div class="card-t" style="margin-bottom:10px">Tìm kiếm gần đây</div>
            @foreach (var search in Model.Searches)
            {
                <div class="sl-row" style="gap:10px;padding:8px 0;border-top:1px solid var(--line)">
                    <span class="grow">"@search.Query"</span>
                    <span class="muted" style="font-size:12.5px">@search.At.ToLocalTime().ToString("dd/MM HH:mm")</span>
                    <span class="chip @(search.Blocked ? "t-r" : "t-n")">@(search.Blocked ? "Từ khóa bị chặn" : $"{search.Results} kết quả")</span>
                </div>
            }
            @if (Model.Searches.Count == 0)
            {
                <p class="muted" style="margin:0">Chưa tìm kiếm lần nào.</p>
            }
        </div>
    </div>
    <div class="sl-col" style="flex:1 1 320px;min-width:0;gap:16px">
        <div class="sl-card">
            <div class="card-t" style="margin-bottom:10px">Số phút học 14 ngày qua</div>
            @foreach (var (day, minutes) in Model.Days)
            {
                <div class="sl-row" style="gap:10px;padding:4px 0;font-size:13px">
                    <span class="muted" style="width:52px">@day.ToString("dd/MM")</span>
                    <div class="bar grow"><i style="width:@(minutes * 100 / maxMinutes)%"></i></div>
                    <span class="b" style="width:56px;text-align:right">@minutes phút</span>
                </div>
            }
        </div>
        <div class="sl-card">
            <div class="card-t" style="margin-bottom:10px">Báo cáo nội dung của bé</div>
            @foreach (var report in Model.Reports)
            {
                <div style="padding:10px 0;border-top:1px solid var(--line)">
                    <div class="sl-row" style="gap:8px"><span class="b grow">@report.Target</span><span class="chip @ReportStatus.Tone(report.Status)">@ReportStatus.Label(report.Status)</span></div>
                    <div class="muted" style="font-size:12.5px">@ReportStatus.Reason(report.Reason)@(report.Comment is null ? "" : " · \"" + report.Comment + "\"") · @report.CreatedAt.ToLocalTime().ToString("dd/MM HH:mm")</div>
                    @if (report.Resolution is not null)
                    {
                        <div style="font-size:12.5px;margin-top:4px">Quản trị viên: @report.Resolution</div>
                    }
                </div>
            }
            @if (Model.Reports.Count == 0)
            {
                <p class="muted" style="margin:0">Bé chưa báo cáo nội dung nào.</p>
            }
        </div>
    </div>
</div>
