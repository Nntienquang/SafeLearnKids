@{
    ViewData["Title"] = """Lịch sử học""";
    ViewData["Page"] = "history";
    ViewData["Nav"] = "history";
    ViewData["Crumb"] = Html.Raw("""Phụ huynh · Giám sát""");
    ViewData["Heading"] = """Lịch sử học và báo cáo nội dung""";
    ViewData["Sub"] = """Xem bé đã học gì, bao lâu, và xử lý báo cáo nội dung (US-20, 21).""";
}
@section Actions {
<button class="sl-btn" type="button"><i class="ic ic-download"></i>Xuất CSV</button>
}
