@model LibraryViewModel
@{
    ViewData["Title"] = """Thư viện bài học""";
    ViewData["Page"] = "library-sql";
    ViewData["Nav"] = "library";
    ViewData["Crumb"] = Html.Raw("""Phụ huynh · Nội dung""");
    ViewData["Heading"] = """Thư viện bài học""";
    ViewData["Sub"] = """Bài học đã được quản trị viên kiểm duyệt, lọc theo môn, lớp và loại bài (US-16).""";
    var filter = new Dictionary<string, string?>
    {
        ["subject"] = Model.Subject, ["grade"] = Model.Grade?.ToString(), ["type"] = Model.Type, ["tag"] = Model.Tag?.ToString(), ["q"] = Model.Q
    };
    string Gradient(string key)
    {
        var look = Model.Subjects.FirstOrDefault(item => item.Key == key);
        return look is null ? "var(--grad)" : $"linear-gradient(135deg,{look.C[0]},{look.C[1]})";
    }
}
<form method="get" asp-action="Index" class="sl-row" style="gap:10px;flex-wrap:wrap;margin-bottom:18px">
    <input class="inp inp-sm grow" style="min-width:200px" type="search" name="q" value="@Model.Q" maxlength="200" aria-label="Tìm bài học" placeholder="Tìm theo tên bài, mục tiêu hoặc nhãn" />
    <select class="inp inp-sm" style="width:auto" name="subject" aria-label="Lọc theo môn">
        <option value="">Mọi môn</option>
        @foreach (var subject in Model.Subjects)
        {
            <option value="@subject.Key" selected="@(Model.Subject == subject.Key)">@subject.Name</option>
        }
    </select>
    <select class="inp inp-sm" style="width:auto" name="grade" aria-label="Lọc theo lớp">
        <option value="">Mọi lớp</option>
        @for (var level = 1; level <= 5; level++)
        {
            <option value="@level" selected="@(Model.Grade == level)">Lớp @level</option>
        }
    </select>
    <select class="inp inp-sm" style="width:auto" name="type" aria-label="Lọc theo loại bài">
        <option value="">Mọi loại</option>
        @foreach (var type in LessonKind.Types)
        {
            <option value="@type" selected="@(Model.Type == type)">@LessonKind.TypeLabel(type)</option>
        }
    </select>
    @if (Model.Tags.Count > 0)
    {
        <select class="inp inp-sm" style="width:auto" name="tag" aria-label="Lọc theo nhãn">
            <option value="">Mọi nhãn</option>
            @foreach (var tag in Model.Tags)
            {
                <option value="@tag.Id" selected="@(Model.Tag == tag.Id)">@tag.Name</option>
            }
        </select>
    }
    <select class="inp inp-sm" style="width:auto" name="source" aria-label="Lọc theo nguồn bài">
        <option value="">Mọi nguồn</option>
        <option value="standard" selected="@(Model.Source == "standard")">Thư viện chuẩn</option>
        <option value="community" selected="@(Model.Source == "community")">Cộng đồng</option>
        <option value="family" selected="@(Model.Source == "family")">Bài của gia đình</option>
    </select>
    <button class="sl-btn sl-btn-p" type="submit"><i class="ic ic-search"></i>Lọc</button>
</form>
<div class="muted" style="margin-bottom:12px">@Model.Matching bài học</div>
<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:16px">
    @foreach (var card in Model.Cards)
    {
        <a class="sl-card" asp-action="Details" asp-route-id="@card.Id" style="padding:0;overflow:hidden;display:flex;flex-direction:column">
            <div style="height:112px;background:@Gradient(card.SubjectKey);display:flex;align-items:center;justify-content:center;color:#fff" aria-hidden="true"><i class="ic ic-@LessonKind.Icon(card.LessonType) ic-xl"></i></div>
            <div style="padding:16px;display:flex;flex-direction:column;gap:10px">
                <div class="sl-row" style="gap:6px;flex-wrap:wrap"><span class="chip t-p">@card.Subject</span><span class="chip t-n">@LessonKind.TypeLabel(card.LessonType)</span>@if (card.Source is not null)
                {
                    <span class="chip @card.SourceTone">@card.SourceLabel</span>
                }@if (card.AssignedTo > 0)
                {
                    <span class="chip t-b" style="margin-left:auto">Đã giao @card.AssignedTo bé</span>
                }</div>
                <span class="b" style="font-size:16px;line-height:1.3">@card.Title</span>
                <div class="muted" style="font-size:12.5px">@card.DurationMin phút · Lớp @card.Grade@(card.Tags.Count == 0 ? "" : " · " + string.Join(", ", card.Tags))@(card.Source == "community" && card.Author is not null ? " · chia sẻ bởi " + card.Author : "")</div>
            </div>
        </a>
    }
</div>
@if (Model.Cards.Count == 0)
{
    <div class="empty">Chưa có bài học phù hợp. Hãy thử bỏ bớt bộ lọc.</div>
}
@if (Model.TotalPages > 1)
{
    <div class="sl-row" style="gap:10px;margin-top:20px;justify-content:center;align-items:center">
        @if (Model.Page > 1)
        {
            <a class="sl-btn sl-btn-sm" asp-action="Index" asp-all-route-data="filter!" asp-route-page="@(Model.Page - 1)">Trước</a>
        }
        <span class="muted">Trang @Model.Page/@Model.TotalPages</span>
        @if (Model.Page < Model.TotalPages)
        {
            <a class="sl-btn sl-btn-sm" asp-action="Index" asp-all-route-data="filter!" asp-route-page="@(Model.Page + 1)">Sau</a>
        }
    </div>
}
