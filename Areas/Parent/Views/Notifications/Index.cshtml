@model NotificationsViewModel
@{
    ViewData["Title"] = """Thông báo""";
    ViewData["Page"] = "notifications-sql";
    ViewData["Nav"] = "notifications";
    ViewData["Crumb"] = Html.Raw("""Phụ huynh · Tài khoản""");
    ViewData["Heading"] = """Thông báo""";
    ViewData["Sub"] = $"{Model.Unread} thông báo chưa đọc. Chọn loại muốn nhận ở Cài đặt (US-50).";
}
@section Actions {
<div class="sl-row" style="gap:8px;flex-wrap:wrap">
    <a class="sl-btn sl-btn-sm @(Model.UnreadOnly ? "" : "sl-btn-p")" asp-action="Index">Tất cả</a>
    <a class="sl-btn sl-btn-sm @(Model.UnreadOnly ? "sl-btn-p" : "")" asp-action="Index" asp-route-unread="true">Chưa đọc (@Model.Unread)</a>
    <form asp-action="ReadAll" method="post"><button class="sl-btn sl-btn-sm" type="submit"><i class="ic ic-check"></i>Đánh dấu đã đọc</button></form>
    <a class="sl-btn sl-btn-sm" href="/settings"><i class="ic ic-sliders"></i>Cài đặt</a>
</div>
}
@if (TempData["Info"] is string info)
{
    <div class="banner t-g" role="status" style="margin-bottom:16px">@info</div>
}
<div class="sl-card">
    @foreach (var row in Model.Rows)
    {
        <div class="sl-row" style="gap:14px;padding:14px 0;border-top:1px solid var(--line);flex-wrap:wrap">
            <span class="ib @NotificationKind.Tone(row.Type)" aria-hidden="true"><i class="ic ic-@NotificationKind.Icon(row.Type)"></i></span>
            <div class="grow" style="min-width:200px">
                <div class="b">@if (!row.IsRead) {<span class="sr-only">Chưa đọc: </span><i style="display:inline-block;width:8px;height:8px;border-radius:4px;background:var(--primary);margin-right:6px" aria-hidden="true"></i>}@row.Title</div>
                @if (row.Body is not null)
                {
                    <div style="font-size:13.5px;margin-top:2px">@row.Body</div>
                }
                <div class="muted" style="font-size:12px;margin-top:2px">@NotificationKind.Label(row.Type) · @row.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
            </div>
            <form asp-action="Open" asp-route-id="@row.Id" method="post"><button class="sl-btn sl-btn-sm @(row.IsRead ? "" : "sl-btn-p")" type="submit">@(row.Link is null ? "Đã đọc" : "Xem")</button></form>
            <form asp-action="Delete" asp-route-id="@row.Id" method="post"><button class="sl-btn sl-btn-sm" type="submit" aria-label="Xóa thông báo @row.Title"><i class="ic ic-trash"></i></button></form>
        </div>
    }
    @if (Model.Rows.Count == 0)
    {
        <div class="empty">@(Model.UnreadOnly ? "Không có thông báo chưa đọc." : "Chưa có thông báo nào.")</div>
    }
</div>
@if (Model.TotalPages > 1)
{
    <nav class="sl-row" style="gap:8px;justify-content:center;margin-top:16px" aria-label="Phân trang">
        @for (var p = 1; p <= Model.TotalPages; p++)
        {
            <a class="sl-btn sl-btn-sm @(p == Model.Page ? "sl-btn-p" : "")" asp-action="Index" asp-route-page="@p" asp-route-unread="@(Model.UnreadOnly ? "true" : null)" aria-current="@(p == Model.Page ? "page" : null)">@p</a>
        }
    </nav>
}
