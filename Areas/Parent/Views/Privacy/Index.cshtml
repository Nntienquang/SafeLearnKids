@{
    ViewData["Title"] = """Dữ liệu và quyền riêng tư""";
    ViewData["Page"] = "privacy";
    ViewData["Nav"] = "privacy";
    ViewData["Crumb"] = Html.Raw("""Phụ huynh · Tài khoản""");
    ViewData["Heading"] = """Dữ liệu và quyền riêng tư""";
    ViewData["Sub"] = """Ba mẹ kiểm soát dữ liệu của bé: xem, xuất và xóa (US-31).""";
}
<div style="display:flex;flex-wrap:wrap;gap:16px;align-items:flex-start">
<div class="sl-card" style="flex:1 1 440px;min-width:0"><div class="card-t" style="margin-bottom:12px">Chúng tôi lưu gì về bé</div>
<div class="sl-row" style="gap:14px;padding:12px 0;border-top:1px solid var(--line)"><span class="ib t-p"><i class="ic ic-user"></i></span><div class="grow"><div class="b">Tên hoặc biệt danh, lớp</div><div class="muted" style="font-size:12.5px">Để hiển thị và chọn bài phù hợp</div></div><i class="ic ic-checkc" style="color:var(--green)"></i></div><div class="sl-row" style="gap:14px;padding:12px 0;border-top:1px solid var(--line)"><span class="ib t-b"><i class="ic ic-history"></i></span><div class="grow"><div class="b">Lịch sử học và điểm quiz</div><div class="muted" style="font-size:12.5px">Để tạo tiến độ và báo cáo</div></div><i class="ic ic-checkc" style="color:var(--green)"></i></div><div class="sl-row" style="gap:14px;padding:12px 0;border-top:1px solid var(--line)"><span class="ib t-a"><i class="ic ic-clock"></i></span><div class="grow"><div class="b">Thời gian học theo ngày</div><div class="muted" style="font-size:12.5px">Để áp giới hạn giờ</div></div><i class="ic ic-checkc" style="color:var(--green)"></i></div><div class="sl-row" style="gap:14px;padding:12px 0;border-top:1px solid var(--line)"><span class="ib t-r"><i class="ic ic-camera"></i></span><div class="grow"><div class="b">Họ tên đầy đủ, ảnh, vị trí</div><div class="muted" style="font-size:12.5px">Không thu thập</div></div><i class="ic ic-x" style="color:var(--rose)"></i></div><div class="sl-row" style="gap:14px;padding:12px 0;border-top:1px solid var(--line)"><span class="ib t-r"><i class="ic ic-eye"></i></span><div class="grow"><div class="b">Quảng cáo và theo dõi bên thứ ba</div><div class="muted" style="font-size:12.5px">Không sử dụng</div></div><i class="ic ic-x" style="color:var(--rose)"></i></div></div>
<div class="sl-col" style="flex:1 1 360px;min-width:0;gap:16px">
<div class="sl-card"><div class="card-t" style="margin-bottom:6px">Xuất dữ liệu</div><div class="card-s" style="margin-bottom:12px">Tải toàn bộ dữ liệu học của Minh An dạng CSV hoặc JSON.</div><button class="sl-btn sl-btn-block" type="button"><i class="ic ic-download"></i>Tải dữ liệu của bé</button></div>
<div class="sl-card" style="border:1px solid var(--rose)"><div class="sl-row" style="gap:12px"><span class="ib t-r"><i class="ic ic-trash"></i></span><div class="grow"><div class="card-t">Xóa hồ sơ và dữ liệu</div><div class="card-s">Xóa vĩnh viễn trong 30 ngày. Không thể hoàn tác.</div></div></div><button class="sl-btn sl-btn-d sl-btn-block" style="margin-top:14px" type="button">Xóa hồ sơ Minh An</button></div>
<div class="banner t-g" style="font-weight:600;font-size:13.5px"><i class="ic ic-shield"></i>PIN lưu dạng băm. Dữ liệu trẻ chỉ ba mẹ và hệ thống truy cập được.</div></div></div>
