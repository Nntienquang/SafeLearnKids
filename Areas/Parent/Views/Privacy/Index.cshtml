@model PrivacyViewModel
@{
    ViewData["Title"] = """Dữ liệu và quyền riêng tư""";
    ViewData["Page"] = "privacy-sql";
    ViewData["Nav"] = "privacy";
    ViewData["Crumb"] = Html.Raw("""Phụ huynh · Tài khoản""");
    ViewData["Heading"] = """Dữ liệu và quyền riêng tư""";
    ViewData["Sub"] = """Ba mẹ kiểm soát dữ liệu của bé: tải về hoặc yêu cầu xóa (US-52).""";
    var pending = Model.Requests.Where(item => item.Type == "Delete" && item.Status is DataRequestStatus.Pending or DataRequestStatus.Processing).Select(item => item.ChildId).ToHashSet();
}
@if (TempData["Info"] is string info)
{
    <div class="banner t-g" role="status" style="margin-bottom:16px">@info</div>
}
@if (TempData["Error"] is string error)
{
    <div class="banner t-r" role="alert" style="margin-bottom:16px">@error</div>
}
<div style="display:flex;flex-wrap:wrap;gap:16px;align-items:flex-start">
    <div class="sl-col" style="flex:2 1 460px;min-width:0;gap:16px">
        @foreach (var child in Model.Children)
        {
            <div class="sl-card">
                <div class="sl-row" style="gap:12px;flex-wrap:wrap">
                    <span class="av" aria-hidden="true">@child.Init</span>
                    <div class="grow"><div class="card-t">@child.Name</div><div class="muted" style="font-size:12.5px">Lớp @child.Grade</div></div>
                    <form asp-action="Export" asp-route-child="@child.Id" method="post"><button class="sl-btn" type="submit"><i class="ic ic-download"></i>Tải dữ liệu (JSON)</button></form>
                </div>
                @if (pending.Contains(child.Id))
                {
                    <div class="banner t-a" style="margin-top:12px"><i class="ic ic-clock"></i>Đang chờ quản trị viên xóa dữ liệu của bé.</div>
                }
                else
                {
                    <details style="margin-top:12px">
                        <summary class="b" style="cursor:pointer;color:var(--rose-text)"><i class="ic ic-trash"></i> Yêu cầu xóa hồ sơ và dữ liệu</summary>
                        <form asp-action="RequestDelete" asp-route-child="@child.Id" method="post" class="sl-col" style="gap:8px;margin-top:10px">
                            <p class="muted" style="margin:0;font-size:13px">Sau khi quản trị viên xử lý, hồ sơ, lịch sử học, điểm bài tập, huy hiệu và giờ học của bé bị xóa vĩnh viễn. Nên tải dữ liệu về trước.</p>
                            <label class="lab" for="confirm-@child.Id">Nhập tên "@child.Name" để xác nhận</label>
                            <input class="inp" id="confirm-@child.Id" name="confirmName" autocomplete="off" required />
                            <button class="sl-btn sl-btn-d" type="submit" style="align-self:flex-start">Gửi yêu cầu xóa</button>
                        </form>
                    </details>
                }
            </div>
        }
        <div class="sl-card" style="padding:6px 0;overflow-x:auto">
            <div class="card-t" style="padding:12px 18px 0">Yêu cầu về dữ liệu</div>
            <table class="tbl">
                <thead><tr><th>Loại</th><th>Bé</th><th>Gửi lúc</th><th>Trạng thái</th><th></th></tr></thead>
                <tbody>
                    @foreach (var request in Model.Requests)
                    {
                        <tr>
                            <td>@(request.Type == "Delete" ? "Xóa dữ liệu" : "Tải dữ liệu")</td>
                            <td>@request.ChildName</td>
                            <td class="muted">@request.RequestedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            <td><span class="chip @DataRequestStatus.Tone(request.Status)">@DataRequestStatus.Label(request.Status)</span>@if (request.Note is not null) {<div class="muted" style="font-size:12px">@request.Note</div>}</td>
                            <td>
                                @if (request.Status == DataRequestStatus.Pending)
                                {
                                    <form asp-action="Cancel" asp-route-id="@request.Id" method="post"><button class="sl-btn sl-btn-sm" type="submit">Hủy yêu cầu</button></form>
                                }
                            </td>
                        </tr>
                    }
                    @if (Model.Requests.Count == 0)
                    {
                        <tr><td colspan="5"><div class="empty">Chưa có yêu cầu nào.</div></td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="sl-col" style="flex:1 1 320px;min-width:0;gap:16px">
        <div class="sl-card">
            <div class="card-t" style="margin-bottom:10px">Chúng tôi lưu gì về bé</div>
            <ul style="margin:0;padding-left:18px;line-height:1.8;font-size:13.5px">
                <li>Tên hoặc biệt danh, lớp, năm sinh (nếu có), môn học</li>
                <li>Bài đã học, tiến độ, bài yêu thích, bài được giao</li>
                <li>Bài làm và điểm bài tập</li>
                <li>Số phút học mỗi ngày, yêu cầu thêm giờ</li>
                <li>Từ khóa bé tìm, báo cáo nội dung của bé</li>
                <li>Huy hiệu, chuỗi ngày học, mục tiêu, lộ trình, báo cáo tuần</li>
            </ul>
            <p class="muted" style="margin:10px 0 0;font-size:12.5px">Không thu thập ảnh, vị trí hay liên hệ của bé. Không có quảng cáo.</p>
        </div>
        <div class="sl-card">
            <div class="card-t" style="margin-bottom:10px">Văn bản đã đồng ý</div>
            @foreach (var consent in Model.Consents)
            {
                <div class="sl-row" style="gap:8px;padding:6px 0;border-top:1px solid var(--line);font-size:13.5px">
                    <span class="grow">@(consent.Type == "Terms" ? "Điều khoản sử dụng" : "Chính sách dữ liệu trẻ em") · bản @consent.Version@(consent.Child is null ? "" : " · " + consent.Child)</span>
                    <span class="chip @(consent.Decision == "Accepted" ? "t-g" : "t-n")">@(consent.Decision == "Accepted" ? "Đã đồng ý" : consent.Decision == "Revoked" ? "Đã rút" : "Từ chối")</span>
                </div>
                <div class="muted" style="font-size:12px">@consent.DecidedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
            }
            <div class="sl-col" style="gap:8px;margin-top:12px">
                <a class="sl-btn sl-btn-block" href="/child-data-policy" target="_blank" rel="noopener">Chính sách dữ liệu của trẻ em</a>
                <a class="sl-btn sl-btn-block" href="/terms" target="_blank" rel="noopener">Điều khoản sử dụng</a>
            </div>
        </div>
    </div>
</div>
