@{
    ViewData["Title"] = """Bài đọc""";
    ViewData["Page"] = "kids-reading";
}
<main style="flex:1;min-width:0;padding:8px 48px 40px;display:flex;flex-direction:column;gap:22px"><div class="sl-row" style="gap:14px;flex-wrap:wrap"><a class="k-pill" href="~/kids-subject"><i class="ic ic-arrowl"></i>Toán</a><span class="k-pill p">Bài đọc 3 phút</span></div>
<div style="display:flex;flex-wrap:wrap;gap:22px;align-items:flex-start"><article class="k-card" style="flex:2 1 560px;min-width:0;padding:34px;display:flex;flex-direction:column;gap:18px">
<h1 class="kf" style="font-size:38px">Quy luật của bảng nhân 5</h1>
<p style="font-size:20px;line-height:1.85;font-weight:600">Khi nhân một số với 5, kết quả luôn tận cùng là <mark style="background:#FFE7A3;border-radius:8px;padding:2px 8px">0</mark> hoặc <mark style="background:#FFE7A3;border-radius:8px;padding:2px 8px">5</mark>.</p>
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(110px,1fr));gap:12px"><div style="text-align:center;padding:14px;border-radius:18px;background:var(--primary-soft);color:var(--primary-text);font-weight:800;font-size:18px">5 × 1 = 5</div><div style="text-align:center;padding:14px;border-radius:18px;background:var(--primary-soft);color:var(--primary-text);font-weight:800;font-size:18px">5 × 2 = 10</div><div style="text-align:center;padding:14px;border-radius:18px;background:var(--primary-soft);color:var(--primary-text);font-weight:800;font-size:18px">5 × 3 = 15</div><div style="text-align:center;padding:14px;border-radius:18px;background:var(--primary-soft);color:var(--primary-text);font-weight:800;font-size:18px">5 × 4 = 20</div><div style="text-align:center;padding:14px;border-radius:18px;background:var(--primary-soft);color:var(--primary-text);font-weight:800;font-size:18px">5 × 5 = 25</div><div style="text-align:center;padding:14px;border-radius:18px;background:var(--primary-soft);color:var(--primary-text);font-weight:800;font-size:18px">5 × 6 = 30</div></div>
<p style="font-size:20px;line-height:1.85;font-weight:600">Số lần chẵn thì kết quả tận cùng 0, số lần lẻ thì tận cùng 5. Con thử với 5 × 7 nhé!</p></article>
<div class="sl-col" style="flex:1 1 260px;gap:16px"><div class="k-card"><div class="kf" style="font-size:20px;margin-bottom:10px">Con học được</div><div class="sl-col" style="gap:10px;font-weight:600"><span class="sl-row" style="gap:10px"><i class="ic ic-checkc" style="color:var(--green)"></i>Thuộc bảng nhân 5</span><span class="sl-row" style="gap:10px"><i class="ic ic-checkc" style="color:var(--green)"></i>Nhận ra chữ số tận cùng</span></div></div><a class="k-btn" href="~/kids-quiz" style="text-align:center;justify-content:center">Làm quiz</a></div></div></main>
