@model KidHomeViewModel
@{
    ViewData["Title"] = """Trang học của bé""";
    ViewData["Page"] = "kids-home-sql";
    var next = Model.Continue ?? Model.Assigned.FirstOrDefault(card => !card.Done);
}
<main style="flex:1;min-width:0;padding:8px 48px 40px;display:flex;flex-direction:column;gap:22px">
<div style="display:flex;flex-wrap:wrap;gap:22px;align-items:stretch">
    <div class="k-card" style="flex:2 1 520px;min-width:0;background:var(--grad);color:#fff;border-color:transparent;display:flex;flex-wrap:wrap;gap:22px;align-items:center;padding:28px">
        <div class="grow sl-col" style="gap:12px;min-width:240px">
            <div class="kf" style="font-size:40px;line-height:1.05">Chào @Model.Kid.Name!<br>@(next is null ? "Hôm nay con chọn môn nào?" : "Học tiếp nhé")</div>
            @if (next is not null)
            {
                <div style="opacity:.92;font-weight:600">@next.Title · @(next.Percent > 0 ? $"đã học {next.Percent}%" : next.Subject)</div>
                <a class="k-btn y" href="/kids-lesson?id=@next.Id" style="align-self:flex-start"><i class="ic ic-play"></i>@(next.Percent > 0 ? "Học tiếp" : "Bắt đầu")</a>
            }
        </div>
        <div style="width:200px;height:140px;border-radius:24px;background:rgba(255,255,255,.2);display:flex;align-items:center;justify-content:center" aria-hidden="true"><i class="ic ic-play ic-xl"></i></div>
    </div>
    <div class="k-card" style="flex:1 1 280px;min-width:0;display:flex;flex-direction:column;gap:14px">
        <div class="kf" style="font-size:22px">Hôm nay của con</div>
        <div class="sl-row" style="gap:16px"><div class="donut" data-today><b>0<small>phút</small></b></div><div class="sl-col" style="gap:6px"><span class="k-note" data-left></span><span style="font-weight:800;color:var(--primary-text)">Giỏi lắm!</span></div></div>
    </div>
</div>
<section>
    <div class="kf" style="font-size:26px;margin-bottom:14px">Chọn môn học</div>
    <div style="display:flex;flex-wrap:wrap;gap:18px">
        @foreach (var subject in Model.Subjects)
        {
            var pct = subject.Total == 0 ? 0 : subject.Done * 100 / subject.Total;
            <a class="k-card" href="/kids-subject?s=@subject.Key" style="flex:1 1 200px;display:flex;flex-direction:column;gap:12px;background:linear-gradient(135deg,@subject.C[0],@subject.C[1]);color:#fff;border-color:transparent">
                <i class="ic ic-@subject.Icon ic-xl" aria-hidden="true"></i>
                <div class="kf" style="font-size:26px">@subject.Name</div>
                <div style="font-weight:700;font-size:14px;opacity:.95">@subject.Done/@subject.Total bài</div>
                <div style="height:8px;border-radius:4px;background:rgba(255,255,255,.3)"><i style="display:block;height:8px;border-radius:4px;background:#fff;width:@(pct)%"></i></div>
            </a>
        }
        @if (Model.Subjects.Count == 0)
        {
            <div class="empty grow">Ba mẹ chưa chọn môn cho con.</div>
        }
    </div>
</section>
<section>
    <div class="kf" style="font-size:26px;margin-bottom:14px">Bài ba mẹ giao</div>
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:18px">
        @foreach (var card in Model.Assigned)
        {
            <partial name="_LessonCard" model="card" />
        }
    </div>
    @if (Model.Assigned.Count == 0)
    {
        <div class="empty">Ba mẹ chưa giao bài mới.</div>
    }
</section>
@if (Model.Quizzes.Count > 0)
{
    <section>
        <div class="kf" style="font-size:26px;margin-bottom:14px">Bài tập ba mẹ giao</div>
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:18px">
            @foreach (var quiz in Model.Quizzes)
            {
                <partial name="_QuizCard" model="quiz" />
            }
        </div>
    </section>
}
@if (Model.Favorites.Count > 0)
{
    <section>
        <div class="kf" style="font-size:26px;margin-bottom:14px">Bài con yêu thích</div>
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:18px">
            @foreach (var card in Model.Favorites)
            {
                <partial name="_LessonCard" model="card" />
            }
        </div>
    </section>
}
</main>
