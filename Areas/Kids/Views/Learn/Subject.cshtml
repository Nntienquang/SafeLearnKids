@model KidSubjectViewModel
@{
    ViewData["Title"] = Model.Subject.Name;
    ViewData["Page"] = "kids-subject-sql";
    var pct = Model.Subject.Total == 0 ? 0 : Model.Subject.Done * 100 / Model.Subject.Total;
}
<main style="flex:1;min-width:0;padding:8px 48px 40px;display:flex;flex-direction:column;gap:22px">
<div class="sl-row" style="gap:16px;flex-wrap:wrap"><a class="k-pill" href="~/kids-home"><i class="ic ic-arrowl"></i>Quay lại</a><h1 class="kf" style="font-size:40px">@Model.Subject.Name · Lớp @Model.Kid.Grade</h1><span class="grow"></span><span class="k-pill p">@Model.Subject.Done/@Model.Subject.Total bài</span></div>
<div class="k-card" style="padding:14px 22px"><div class="bar bar-l" style="height:14px"><i style="width:@(pct)%;background:#FFB020"></i></div></div>
<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:18px">
    @foreach (var card in Model.Lessons)
    {
        <partial name="_LessonCard" model="card" />
    }
</div>
@if (Model.Lessons.Count == 0)
{
    <div class="empty">Môn này chưa có bài cho lớp @Model.Kid.Grade. Con chọn môn khác nhé.</div>
}
</main>
