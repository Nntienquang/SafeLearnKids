@{
    ViewData["Title"] = """Dành cho ba mẹ""";
    ViewData["Page"] = "kids-exit";
    ViewData["NoTop"] = true;
    const string key = "width:64px;height:64px;border-radius:20px;font-size:22px;font-weight:800;color:var(--text)";
}
<main style="flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:18px;padding:40px 16px">
<span class="ib t-p" style="width:56px;height:56px;border-radius:18px"><i class="ic ic-lock ic-lg"></i></span>
<h1 class="kf" style="font-size:32px;text-align:center">Nhập PIN của ba mẹ</h1>
<div class="sl-row" id="pin-dots" style="gap:14px" aria-hidden="true"><span style="width:18px;height:18px;border-radius:9px;border:1px solid var(--line)"></span><span style="width:18px;height:18px;border-radius:9px;border:1px solid var(--line)"></span><span style="width:18px;height:18px;border-radius:9px;border:1px solid var(--line)"></span><span style="width:18px;height:18px;border-radius:9px;border:1px solid var(--line)"></span></div>
<span class="err hidden" id="pin-err" role="alert"></span>
<div style="display:grid;grid-template-columns:repeat(3,64px);gap:12px;justify-content:center">
@foreach (var digit in "123456789")
{
    <button type="button" class="icbtn pin-key" style="@key" data-k="@digit" aria-label="Số @digit">@digit</button>
}
<span></span>
<button type="button" class="icbtn pin-key" style="@key" data-k="0" aria-label="Số 0">0</button>
<button type="button" class="icbtn pin-key" style="@key" data-k="back" aria-label="Xóa"><i class="ic ic-arrowl"></i></button>
</div>
<a class="sl-btn sl-btn-g" id="pin-back" href="~/kids-picker"><i class="ic ic-arrowl"></i>Quay lại học</a>
</main>
