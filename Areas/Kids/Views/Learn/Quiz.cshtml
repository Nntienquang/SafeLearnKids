@{
    ViewData["Title"] = """Làm quiz""";
    ViewData["Page"] = "kids-quiz";
}
<main style="flex:1;min-width:0;padding:8px 48px 40px;display:flex;flex-direction:column;gap:22px"><div class="sl-row" style="gap:14px;flex-wrap:wrap"><a class="k-pill" href="~/kids-lesson"><i class="ic ic-x"></i>Thoát</a><div class="grow k-card" style="padding:12px 18px"><div class="bar bar-l" style="height:14px"><i style="width:60%;background:#22C55E"></i></div></div><span class="k-pill p">Câu 3 / 5</span></div>
<div class="k-card" style="padding:34px;display:flex;flex-direction:column;gap:26px;max-width:960px;align-self:center;width:100%">
<div class="kf" style="font-size:38px;text-align:center">5 × 7 = ?</div>
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:16px">
<div style="padding:20px;border-radius:22px;border:3px solid var(--line);background:var(--surface);text-align:center;font-weight:800;font-size:28px;color:var(--text)">30</div><div style="padding:20px;border-radius:22px;border:3px solid #22C55E;background:rgba(34,197,94,.14);text-align:center;font-weight:800;font-size:28px;color:var(--text)">35</div><div style="padding:20px;border-radius:22px;border:3px solid var(--line);background:var(--surface);text-align:center;font-weight:800;font-size:28px;color:var(--text)">40</div><div style="padding:20px;border-radius:22px;border:3px solid var(--line);background:var(--surface);text-align:center;font-weight:800;font-size:28px;color:var(--text)">45</div></div>
<div class="banner t-g" style="font-weight:700"><i class="ic ic-checkc"></i>Đúng rồi! 5 × 7 = 35 vì 5 × 7 = 5 × 5 + 5 × 2.</div>
<div class="sl-row" style="justify-content:space-between"><button class="sl-btn sl-btn-lg" type="button"><i class="ic ic-info"></i>Gợi ý</button><a class="k-btn" href="~/kids-result">Câu tiếp theo<i class="ic ic-arrowr"></i></a></div></div></main>
