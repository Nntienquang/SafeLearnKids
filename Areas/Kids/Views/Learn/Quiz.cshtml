@model KidQuizViewModel
@{
    ViewData["Title"] = Model.Title;
    ViewData["Page"] = "kids-quiz-sql";
    var total = Model.Questions.Count;
}
<main style="flex:1;min-width:0;padding:8px 48px 40px;display:flex;flex-direction:column;gap:22px" data-attempt="@Model.AttemptId" data-seconds="@Model.SecondsLeft">
<div class="sl-row" style="gap:14px;flex-wrap:wrap">
    <a class="k-pill" href="/kids-lesson?id=@Model.LessonId"><i class="ic ic-x"></i>Thoát</a>
    <h1 class="kf grow" style="font-size:30px">@Model.Title</h1>
    @if (Model.SecondsLeft is { } left)
    {
        <span class="k-pill y" data-clock role="timer" aria-live="off"><i class="ic ic-clock"></i>@(left / 60):@((left % 60).ToString("00"))</span>
    }
    <span class="k-pill p" data-step aria-live="polite">@total câu</span>
</div>
@if (Model.DueDate is { } due)
{
    <p class="k-note" style="margin:0">Bài ba mẹ giao · Hạn nộp @due.ToString("dd/MM/yyyy")</p>
}
<div class="k-card" style="padding:12px 18px" hidden data-progress><div class="bar bar-l" style="height:14px"><i style="width:0%;background:#22C55E"></i></div></div>
<form asp-action="Submit" asp-route-attemptId="@Model.AttemptId" method="post" id="quiz-form" class="sl-col" style="gap:18px;max-width:960px;align-self:center;width:100%">
    @for (var i = 0; i < total; i++)
    {
        var question = Model.Questions[i];
        <fieldset class="k-card" data-q="@i" style="padding:28px;display:flex;flex-direction:column;gap:20px;margin:0">
            <legend class="sr-only">Câu @(i + 1) / @total</legend>
            <div class="k-note">Câu @(i + 1) / @total</div>
            <div class="kf" style="font-size:30px;text-align:center" id="q-@question.Id">@question.Text</div>
            <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:14px" role="radiogroup" aria-labelledby="q-@question.Id">
                @foreach (var option in question.Options)
                {
                    <label class="k-opt">
                        <input type="radio" name="q@(question.Id)" value="@option.Id" />
                        <span>@option.Text</span>
                    </label>
                }
            </div>
        </fieldset>
    }
    @if (total == 0)
    {
        <div class="empty">Bài tập này chưa có câu hỏi.</div>
    }
    <div class="sl-row" style="justify-content:space-between;gap:12px;flex-wrap:wrap">
        <button class="sl-btn sl-btn-lg" type="button" data-prev hidden><i class="ic ic-arrowl"></i>Câu trước</button>
        <button class="k-btn" type="button" data-next hidden>Câu tiếp theo<i class="ic ic-arrowr"></i></button>
        <button class="k-btn y" type="submit" data-submit><i class="ic ic-send"></i>Nộp bài</button>
    </div>
    <p class="k-note" data-unanswered hidden role="status"></p>
</form>
</main>
