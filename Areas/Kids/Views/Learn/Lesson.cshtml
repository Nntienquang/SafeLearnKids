@{
    ViewData["Title"] = """Xem video an toàn""";
    ViewData["Page"] = "kids-lesson";
}
<main style="flex:1;min-width:0;padding:8px 48px 40px;display:flex;flex-direction:column;gap:22px"><div class="sl-row" style="gap:14px;flex-wrap:wrap"><a class="k-pill" href="~/kids-subject"><i class="ic ic-arrowl"></i>Toán</a><div class="kf" style="font-size:34px">Bảng nhân 5</div></div>
<div style="display:flex;flex-wrap:wrap;gap:22px;align-items:flex-start"><div class="sl-col" style="flex:2 1 560px;min-width:0;gap:16px">
<div style="aspect-ratio:16/9;border-radius:28px;background:linear-gradient(135deg,#1E1B4B,#4F46E5);display:flex;align-items:center;justify-content:center;position:relative;color:#fff;box-shadow:var(--shadow)"><span style="width:92px;height:92px;border-radius:46px;background:#fff;color:#4F46E5;display:flex;align-items:center;justify-content:center"><i class="ic ic-play ic-xl"></i></span>
<div style="position:absolute;left:18px;right:18px;bottom:16px;display:flex;align-items:center;gap:14px"><i class="ic ic-pause"></i><div style="flex:1;height:8px;border-radius:4px;background:rgba(255,255,255,.3)"><i style="display:block;width:62%;height:8px;border-radius:4px;background:#FFC93C"></i></div><span style="font-weight:700;font-size:13px">6:12 / 10:00</span></div></div>
<div class="k-card sl-row" style="gap:14px;justify-content:space-between;flex-wrap:wrap"><div class="sl-row" style="gap:12px"><span class="k-pill y"><i class="ic ic-clock"></i>Còn 28 phút</span><span class="k-note">Đang học · ba mẹ đã duyệt</span></div><a class="sl-btn sl-btn-sm" href="~/kids-time-up">Xin thêm giờ</a></div></div>
<div class="sl-col" style="flex:1 1 280px;min-width:0;gap:16px"><div class="k-card"><div class="kf" style="font-size:22px;margin-bottom:10px">Trong bài này</div>
<div class="sl-row" style="gap:12px;padding:10px 0;border-top:1px solid var(--line)"><span class="ib t-p"><i class="ic ic-playc"></i></span><div class="grow b">Xem video</div><i class="ic ic-chevr" style="color:var(--text-3)"></i></div><div class="sl-row" style="gap:12px;padding:10px 0;border-top:1px solid var(--line)"><span class="ib t-t"><i class="ic ic-book"></i></span><div class="grow b">Đọc quy luật</div><i class="ic ic-chevr" style="color:var(--text-3)"></i></div><div class="sl-row" style="gap:12px;padding:10px 0;border-top:1px solid var(--line)"><span class="ib t-a"><i class="ic ic-target"></i></span><div class="grow b">Làm quiz 5 câu</div><i class="ic ic-chevr" style="color:var(--text-3)"></i></div></div>
<a class="k-btn" href="~/kids-quiz" style="text-align:center;justify-content:center">Làm quiz ngay</a><button class="sl-btn sl-btn-block" type="button"><i class="ic ic-flag"></i>Video này có gì lạ?</button></div></div></main>
