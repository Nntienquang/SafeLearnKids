@model TimeUpViewModel
@{
    ViewData["Title"] = """Hết giờ học""";
    ViewData["Page"] = "kids-time-up-sql";
    ViewData["NoTop"] = true;
    var today = Model.Today;
    var minutesOut = today.RemainingSeconds == 0;
    var latest = Model.Latest;
}
<main style="flex:1;display:flex;align-items:center;justify-content:center;padding:40px 16px;background:radial-gradient(circle at 80% 0%,var(--primary-soft),transparent 55%)">
<div class="k-card" style="max-width:640px;width:100%;padding:40px 28px;display:flex;flex-direction:column;align-items:center;gap:20px;text-align:center">
    <span style="width:112px;height:112px;border-radius:56px;background:#E0E7FF;color:#4338CA;display:flex;align-items:center;justify-content:center" aria-hidden="true"><i class="ic ic-moon ic-xl"></i></span>
    @if (today.Allowed)
    {
        <h1 class="kf" style="font-size:40px;line-height:1.1">Con còn @today.RemainingMinutes phút học hôm nay</h1>
        <a class="k-btn" href="~/kids-home"><i class="ic ic-play"></i>Học tiếp</a>
    }
    else
    {
        <h1 class="kf" style="font-size:40px;line-height:1.1">@(minutesOut ? "Hết giờ học hôm nay rồi!" : "Chưa đến giờ học")</h1>
        <p style="font-size:18px;line-height:1.7;font-weight:600;color:var(--text-2);margin:0">@today.Blocked @(minutesOut && today.UsedMinutes > 0 ? $"Con đã học {today.UsedMinutes} phút, giỏi lắm." : "") Nghỉ ngơi, chơi và mai học tiếp nhé.</p>
    }
    @if (TempData["Kid"] is string message)
    {
        <div class="banner t-b" role="status" style="font-weight:700">@message</div>
    }
    @if (latest is { Status: RequestStatus.Pending })
    {
        <div class="banner t-a" style="font-weight:700"><i class="ic ic-clock"></i>Đã xin thêm @latest.RequestedMinutes phút. Đợi ba mẹ trả lời nhé!</div>
    }
    else if (latest is { Status: RequestStatus.Denied } && !today.Allowed)
    {
        <div class="banner t-r" style="font-weight:700">Ba mẹ chưa đồng ý cho thêm giờ hôm nay.</div>
    }
    else if (latest is { Status: RequestStatus.Approved } && today.Allowed)
    {
        <div class="banner t-g" style="font-weight:700"><i class="ic ic-checkc"></i>Ba mẹ cho con thêm @latest.GrantedMinutes phút!</div>
    }
    @if (!today.Allowed && minutesOut && latest is not { Status: RequestStatus.Pending } && Model.RequestsToday < 3)
    {
        <form asp-action="RequestTime" method="post" style="display:flex;flex-direction:column;gap:12px;width:100%;max-width:420px">
            <fieldset style="border:0;padding:0;margin:0">
                <legend class="b" style="margin:0 auto 10px">Con muốn xin thêm bao nhiêu phút?</legend>
                <div class="sl-row" style="gap:8px;justify-content:center;flex-wrap:wrap">
                    @foreach (var minutes in new[] { 5, 10, 15, 30 })
                    {
                        <label class="k-pill" style="cursor:pointer"><input type="radio" name="minutes" value="@minutes" required checked="@(minutes == 15)" />@minutes phút</label>
                    }
                </div>
            </fieldset>
            <label class="lab" for="time-reason">Con nhắn ba mẹ (không bắt buộc)</label>
            <input class="inp" id="time-reason" name="reason" maxlength="200" placeholder="Con muốn học hết bài ạ" />
            <button class="k-btn" type="submit" style="justify-content:center"><i class="ic ic-send"></i>Xin ba mẹ thêm giờ</button>
        </form>
    }
    <div class="sl-row" style="gap:12px;flex-wrap:wrap;justify-content:center">
        <a class="sl-btn sl-btn-lg" href="~/kids-time-up">Xem ba mẹ trả lời chưa</a>
        <a class="sl-btn sl-btn-lg" href="~/kids-exit"><i class="ic ic-lock"></i>Ba mẹ</a>
    </div>
</div>
</main>
