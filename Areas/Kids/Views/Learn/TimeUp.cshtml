@{
    ViewData["Title"] = """Hết giờ học""";
    ViewData["Page"] = "kids-time-up";
    ViewData["NoTop"] = true;
}
<main style="flex:1;display:flex;align-items:center;justify-content:center;padding:40px;background:radial-gradient(circle at 80% 0%,var(--primary-soft),transparent 55%)"><div class="k-card" style="max-width:640px;width:100%;padding:44px;display:flex;flex-direction:column;align-items:center;gap:20px;text-align:center">
<span style="width:112px;height:112px;border-radius:56px;background:#E0E7FF;color:#4338CA;display:flex;align-items:center;justify-content:center"><i class="ic ic-moon ic-xl"></i></span>
<div class="kf" style="font-size:44px;line-height:1.1">Hết giờ học hôm nay rồi!</div>
<p style="font-size:18px;line-height:1.7;font-weight:600;color:var(--text-2)">Con đã học 60 phút, giỏi lắm. Nghỉ ngơi, chơi và mai học tiếp nhé.</p>
<div class="sl-row" style="gap:12px;flex-wrap:wrap;justify-content:center"><button class="k-btn" type="button"><i class="ic ic-send"></i>Xin ba mẹ thêm giờ</button><a class="sl-btn sl-btn-lg" href="~/kids-picker">Đổi bạn khác</a></div>
<div class="banner t-g" style="font-weight:700"><i class="ic ic-checkc"></i>Đã gửi cho ba mẹ. Đợi ba mẹ trả lời nhé!</div></div></main>
