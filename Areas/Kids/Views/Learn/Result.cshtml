@{
    ViewData["Title"] = """Kết quả quiz""";
    ViewData["Page"] = "kids-result";
}
<main style="flex:1;min-width:0;padding:8px 48px 40px;display:flex;flex-direction:column;gap:22px"><div class="k-card" style="max-width:760px;align-self:center;width:100%;padding:40px;display:flex;flex-direction:column;align-items:center;gap:20px;text-align:center">
<span style="width:96px;height:96px;border-radius:48px;background:#FFE7A3;color:#B45309;display:flex;align-items:center;justify-content:center"><i class="ic ic-trophy ic-xl"></i></span>
<div class="kf" style="font-size:44px">Giỏi quá, Minh An!</div>
<div class="sl-row" style="gap:26px"><div><div class="kf" style="font-size:48px;color:var(--primary-text)">4/5</div><span class="k-note">câu đúng</span></div><div><div class="kf" style="font-size:48px;color:#B45309">+40</div><span class="k-note">điểm sao</span></div></div>
<div class="sl-row" style="gap:6px;font-size:34px;color:#FFB020"><i class="ic ic-star ic-lg"></i><i class="ic ic-star ic-lg"></i><i class="ic ic-star ic-lg"></i><i class="ic ic-star ic-lg"></i><i class="ic ic-star ic-lg" style="color:var(--line)"></i></div>
<div class="banner t-p" style="font-weight:700"><i class="ic ic-sparkles"></i>Huy hiệu mới: Siêu chăm chỉ!</div>
<div class="sl-row" style="gap:12px;flex-wrap:wrap;justify-content:center"><a class="sl-btn sl-btn-lg" href="~/kids-quiz"><i class="ic ic-refresh"></i>Làm lại</a><a class="k-btn" href="~/kids-home">Về trang học</a></div></div></main>
